---
import { Image } from 'astro:assets';
import CaseStudy from '../../layouts/CaseStudy.astro';
import CaseSection from '../../components/CaseSection.astro';
import content from '../../i18n/cases/pinsxp';
import { getLang } from '../../i18n';
import { media } from '../../i18n/media';

// Shared markup of the case study; the text comes from src/i18n/cases/pinsxp.ts.
const lang = getLang(Astro.currentLocale);
const c = content[lang];

const cover = media('home/pinsxp.jpg', lang);
const reto1 = media('pinsxp/reto-1.png', lang);
const reto2 = media('pinsxp/reto-2.png', lang);
const reto3 = media('pinsxp/reto-3.png', lang);
const compass1 = media('pinsxp/compass-1.png', lang);
const compass2 = media('pinsxp/compass-2.png', lang);
const impacto = media('pinsxp/impacto.jpg', lang);

const sections = [
  { id: 'reto', title: c.sections.challenge },
  { id: 'metodologia', title: c.sections.method },
  { id: 'solucion', title: c.sections.solution },
  { id: 'impacto', title: c.sections.impact },
  { id: 'proximos-pasos', title: c.sections.next },
];
---

<CaseStudy
  slug="pinsxp"
  name="PinsXP"
  tagline={c.tagline}
  cover={cover}
  description={c.description}
  brief={c.brief}
  details={c.details}
  sections={sections}
>
  <CaseSection id="reto" number={1} title={c.sections.challenge}>
    <p set:html={c.challenge.text} />
    <div class="gallery" style="--cols: 3">
      <Image src={reto1} alt={c.challenge.alts[0]} widths={[600, reto1.width]} sizes="(max-width: 760px) 92vw, 300px" />
      <Image src={reto2} alt={c.challenge.alts[1]} />
      <Image src={reto3} alt={c.challenge.alts[2]} />
    </div>
    <h3>{c.challenge.problemTitle}</h3>
    <ul class="cards">
      {
        c.challenge.problems.map((card) => (
          <li class="card">
            <h4>{card.title}</h4>
            <Fragment set:html={card.text} />
          </li>
        ))
      }
    </ul>
  </CaseSection>

  <CaseSection id="metodologia" number={2} title={c.sections.method}>
    <p>{c.method.text}</p>
    <ol class="cards">
      {
        c.method.steps.map((step) => (
          <li class="card">
            <h4>{step.title}</h4>
            <Fragment set:html={step.text} />
          </li>
        ))
      }
    </ol>
  </CaseSection>

  <CaseSection id="solucion" number={3} title={c.sections.solution}>
    <p>{c.solution.text}</p>
    <div class="gallery" style="--cols: 2">
      <Image src={compass1} alt={c.solution.alts[0]} widths={[728, compass1.width]} sizes="(max-width: 760px) 92vw, 440px" />
      <Image src={compass2} alt={c.solution.alts[1]} widths={[420, compass2.width]} sizes="(max-width: 760px) 92vw, 440px" />
    </div>
    <p class="callout" set:html={c.solution.callout} />
    <ul class="cards">
      {
        c.solution.cards.map((card) => (
          <li class="card">
            <h4>{card.title}</h4>
            <Fragment set:html={card.text} />
          </li>
        ))
      }
    </ul>
    <h3>{c.solution.code.title}</h3>
    <ul class="list">
      {c.solution.code.items.map((item) => <li>{item}</li>)}
    </ul>
  </CaseSection>

  <CaseSection id="impacto" number={4} title={c.sections.impact}>
    <figure class="figma-panel">
      <div class="figma-panel__text">
        <h3 class="figma-panel__title">
          {c.impact.panel.title[0]}<strong>{c.impact.panel.title[1]}</strong>{c.impact.panel.title[2]}
        </h3>
        <ul class="figma-panel__list">
          {
            c.impact.panel.tokens.map((token) => (
              <li>
                <strong>{token.term}</strong> {token.text}
              </li>
            ))
          }
        </ul>
      </div>
      <Image
        class="figma-panel__shot"
        src={impacto}
        alt={c.impact.alt}
        widths={[880, 1760]}
        sizes="(max-width: 1024px) 92vw, 880px"
      />
    </figure>
    <ul class="cards">
      {
        c.impact.cards.map((card) => (
          <li class="card">
            <h4>{card.title}</h4>
            <Fragment set:html={card.text} />
          </li>
        ))
      }
    </ul>
  </CaseSection>

  <CaseSection id="proximos-pasos" number={5} title={c.sections.next}>
    <h3>{c.next.title}</h3>
    <p>{c.next.text}</p>
    <ul class="cards">
      {
        c.next.cards.map((card) => (
          <li class="card">
            <h4>{card.title}</h4>
            <Fragment set:html={card.text} />
          </li>
        ))
      }
    </ul>
  </CaseSection>
</CaseStudy>

<style>
  /* Figma variables panel. impacto.jpg is kept as is; its top band (title and bullets baked in
     Spanish) is hidden by the crop and redrawn in HTML on the same gradient, so it translates. */
  .figma-panel {
    overflow: hidden;
    border-radius: 8px;
    background: radial-gradient(130% 160% at 50% 100%, #04323f 0%, #0b242b 55%, #10181b 100%);
  }

  .figma-panel__text {
    padding: clamp(24px, 5%, 44px) clamp(20px, 4.5%, 40px) clamp(24px, 4%, 36px);
    color: rgb(255 255 255 / 0.82);
    font-size: 15px;
    line-height: 1.65;
  }

  .figma-panel .figma-panel__title {
    margin: 0 0 16px;
    color: var(--white);
    font-size: clamp(24px, 3vw, 32px);
    font-weight: var(--fw-regular);
    line-height: 1.2;
  }

  .figma-panel .figma-panel__title strong {
    color: inherit;
    font-weight: var(--fw-semibold);
  }

  .figma-panel__list {
    display: grid;
    gap: 10px;
    padding-left: 20px;
  }

  .figma-panel__list li::marker {
    color: var(--white);
  }

  .figma-panel .figma-panel__list strong {
    color: var(--white);
    font-weight: var(--fw-medium);
  }

  /* Only the screenshots: rows 444–1080 of the 1920×1080 file */
  .figma-panel .figma-panel__shot {
    display: block;
    aspect-ratio: 1920 / 636;
    object-fit: cover;
    object-position: bottom;
    border-radius: 0;
  }
</style>

---
import { Image } from 'astro:assets';
import CaseStudy from '../../layouts/CaseStudy.astro';
import CaseSection from '../../components/CaseSection.astro';
import content from '../../i18n/cases/pinsxp';
import { getLang } from '../../i18n';
import { media } from '../../i18n/media';

// Shared markup of the case study; the text comes from src/i18n/cases/pinsxp.ts.
const lang = getLang(Astro.currentLocale);
const c = content[lang];

const cover = media('home/pinsxp.jpg', lang);
const reto1 = media('pinsxp/reto-1.png', lang);
const reto2 = media('pinsxp/reto-2.png', lang);
const reto3 = media('pinsxp/reto-3.png', lang);
const compass1 = media('pinsxp/compass-1.png', lang);
const compass2 = media('pinsxp/compass-2.png', lang);
const impacto = media('pinsxp/impacto.jpg', lang);

const sections = [
  { id: 'reto', title: c.sections.challenge },
  { id: 'solucion', title: c.sections.solution },
  { id: 'impacto', title: c.sections.impact },
  { id: 'proximos-pasos', title: c.sections.next },
];
---

<CaseStudy
  slug="pinsxp"
  name="PinsXP"
  tagline={c.tagline}
  cover={cover}
  description={c.description}
  brief={c.brief}
  details={c.details}
  sections={sections}
>
  <CaseSection id="reto" number={1} title={c.sections.challenge}>
    <p set:html={c.challenge.text} />
    <div class="gallery" style="--cols: 3">
      <Image src={reto1} alt={c.challenge.alts[0]} widths={[600, reto1.width]} sizes="(max-width: 760px) 92vw, 300px" />
      <Image src={reto2} alt={c.challenge.alts[1]} />
      <Image src={reto3} alt={c.challenge.alts[2]} />
    </div>
    <h3>{c.challenge.problemTitle}</h3>
    <ul class="cards">
      {
        c.challenge.problems.map((card) => (
          <li class="card">
            <h4>{card.title}</h4>
            <Fragment set:html={card.text} />
          </li>
        ))
      }
    </ul>
  </CaseSection>

  <CaseSection id="solucion" number={2} title={c.sections.solution}>
    <p>{c.solution.text}</p>
    <div class="gallery" style="--cols: 2">
      <Image src={compass1} alt={c.solution.alts[0]} widths={[728, compass1.width]} sizes="(max-width: 760px) 92vw, 440px" />
      <Image src={compass2} alt={c.solution.alts[1]} widths={[420, compass2.width]} sizes="(max-width: 760px) 92vw, 440px" />
    </div>
    <p class="callout" set:html={c.solution.callout} />
    <ul class="cards">
      {
        c.solution.cards.map((card) => (
          <li class="card">
            <h4>{card.title}</h4>
            <Fragment set:html={card.text} />
          </li>
        ))
      }
    </ul>
  </CaseSection>

  <CaseSection id="impacto" number={3} title={c.sections.impact}>
    <h3>{c.impact.panelTitle}</h3>
    <ul class="list">
      {
        c.impact.tokens.map((token) => (
          <li>
            <strong>{token.term}</strong> {token.text}
          </li>
        ))
      }
    </ul>
    <figure>
      <Image src={impacto} alt={c.impact.alt} widths={[880, 1760]} sizes="(max-width: 1024px) 92vw, 880px" />
    </figure>
    <ul class="cards">
      {
        c.impact.cards.map((card) => (
          <li class="card">
            <h4>{card.title}</h4>
            <Fragment set:html={card.text} />
          </li>
        ))
      }
    </ul>
  </CaseSection>

  <CaseSection id="proximos-pasos" number={4} title={c.sections.next}>
    <h3>{c.next.title}</h3>
    <p>{c.next.text}</p>
    <ul class="cards">
      {
        c.next.cards.map((card) => (
          <li class="card">
            <h4>{card.title}</h4>
            <Fragment set:html={card.text} />
          </li>
        ))
      }
    </ul>
  </CaseSection>
</CaseStudy>

---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import contactPhoto from '../assets/photos/contact-page.jpg';
import { site } from '../data/site';
import { getLang, path, useTranslations } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const copy = {
  es: {
    title: 'Contacto',
    description: '¿Tienes un proyecto o una pregunta? Escríbele a Emely Aponte, diseñadora UX/UI en Madrid.',
    heading: ['¡Mándame un ', 'mensaje', '!'],
    intro:
      '¿Tienes una pregunta, un comentario o simplemente te apetece conversar? Escríbeme: estaré encantada de leerte y te responderé lo antes posible.',
    honeypot: 'No rellenes este campo:',
    name: 'Nombre',
    nameError: 'Escribe tu nombre.',
    email: 'Email',
    emailError: 'Escribe un email válido, por ejemplo nombre@dominio.com.',
    topicsLegend: '¿Sobre qué quieres hablar?',
    optional: '(opcional)',
    topics: ['Un proyecto', 'Una oferta de trabajo', 'Una colaboración', 'Otro tema'],
    message: 'Mensaje',
    messageHint: 'Cuéntame en qué puedo ayudarte.',
    messageError: 'Escribe tu mensaje.',
    alt: 'Otras formas de contacto',
    linkedin: 'Escríbeme por mensaje directo',
    behance: 'Mira más de mi trabajo',
  },
  en: {
    title: 'Contact',
    description: 'Have a project or a question? Write to Emely Aponte, UX/UI designer based in Madrid.',
    heading: ['Send me a ', 'message', '!'],
    intro:
      'Have a question, a comment, or just feel like a chat? Write to me: I will be happy to read your message and will reply as soon as I can.',
    honeypot: 'Do not fill in this field:',
    name: 'Name',
    nameError: 'Please enter your name.',
    email: 'Email',
    emailError: 'Please enter a valid email, for example name@domain.com.',
    topicsLegend: 'What would you like to talk about?',
    optional: '(optional)',
    topics: ['A project', 'A job offer', 'A collaboration', 'Something else'],
    message: 'Message',
    messageHint: 'Tell me how I can help.',
    messageError: 'Please write your message.',
    alt: 'Other ways to get in touch',
    linkedin: 'Send me a direct message',
    behance: 'See more of my work',
  },
}[lang];

// Strings for the inline script below
const messages = {
  es: {
    submit: 'Enviar mensaje',
    sending: 'Enviando…',
    invalid: 'Revisa los campos marcados para poder enviar tu mensaje.',
    success: '<strong>¡Gracias! Tu mensaje ya está en camino.</strong> Te responderé lo antes posible.',
    failure: 'No he podido enviar tu mensaje. Inténtalo de nuevo en unos minutos o escríbeme por',
  },
  en: {
    submit: 'Send message',
    sending: 'Sending…',
    invalid: 'Please check the highlighted fields so your message can be sent.',
    success: '<strong>Thank you! Your message is on its way.</strong> I will reply as soon as I can.',
    failure: 'I could not send your message. Please try again in a few minutes or write to me on',
  },
}[lang];
---

<Base title={copy.title} description={copy.description}>
  <section class="contact">
    <Image
      class="contact__photo"
      src={contactPhoto}
      alt=""
      widths={[700, 1100, contactPhoto.width]}
      sizes="(max-width: 900px) 100vw, 55vw"
      loading="eager"
    />

    <div class="container contact__inner">
      <div class="panel contact__panel">
        <p class="eyebrow">{copy.title}</p>
        <h1 class="contact__title">{copy.heading[0]}<span class="highlight highlight--soft">{copy.heading[1]}</span>{copy.heading[2]}</h1>
        <p class="contact__intro">{copy.intro}</p>

        <!-- Netlify Forms: detected at deploy time from this static HTML. Both languages post to the same form. -->
        <form
          class="form"
          name="contacto"
          method="POST"
          action={path('thanks', lang)}
          data-netlify="true"
          netlify-honeypot="empresa-web"
          novalidate
          data-contact-form
        >
          <input type="hidden" name="form-name" value="contacto" />
          <p class="visually-hidden">
            <label>{copy.honeypot} <input name="empresa-web" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div class="form__row">
            <div class="field">
              <label for="contact-name">{copy.name}</label>
              <input id="contact-name" name="nombre" type="text" autocomplete="name" required aria-describedby="contact-name-error" />
              <p class="field__error" hidden id="contact-name-error" data-error-for="nombre">{copy.nameError}</p>
            </div>
            <div class="field">
              <label for="contact-email">{copy.email}</label>
              <input id="contact-email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="contact-email-error" />
              <p class="field__error" hidden id="contact-email-error" data-error-for="email">{copy.emailError}</p>
            </div>
          </div>

          <fieldset class="field field--topics">
            <legend>{copy.topicsLegend} <span class="field__optional">{copy.optional}</span></legend>
            <div class="chips">
              {
                copy.topics.map((topic, index) => (
                  <label class="chip">
                    <input type="radio" name="motivo" value={topic} checked={index === 0} />
                    <span>{topic}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="field">
            <label for="contact-message">{copy.message}</label>
            <textarea id="contact-message" name="mensaje" rows="6" required aria-describedby="contact-message-hint contact-message-error"></textarea>
            <p class="field__hint" id="contact-message-hint">{copy.messageHint}</p>
            <p class="field__error" hidden id="contact-message-error" data-error-for="mensaje">{copy.messageError}</p>
          </div>

          <button class="btn form__submit" type="submit">
            <span data-submit-label>{messages.submit}</span>
            <ArrowIcon />
          </button>

          <p class="form__status" role="status" aria-live="polite" data-status></p>
        </form>

        <ul class="contact__alt" aria-label={copy.alt}>
          <li>
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
              <img src="/icons/linkedin-purple.svg" width="44.3852" height="44.3852" alt="" />
              <span><strong>LinkedIn</strong> {copy.linkedin}</span>
            </a>
          </li>
          <li>
            <a href={site.behance} target="_blank" rel="noopener noreferrer">
              <img src="/icons/behance-purple.svg" width="45.0577" height="45.0577" alt="" />
              <span><strong>Behance</strong> {copy.behance}</span>
            </a>
          </li>
        </ul>
        <p class="contact__place">{site.name} · {t('site.location')}</p>
      </div>
    </div>
  </section>
</Base>

<script define:vars={{ linkedin: site.linkedin, messages }}>
  const form = document.querySelector('[data-contact-form]');
  const status = form.querySelector('[data-status]');
  const button = form.querySelector('button[type="submit"]');
  const buttonLabel = form.querySelector('[data-submit-label]');
  const fields = ['nombre', 'email', 'mensaje'].map((name) => form.elements.namedItem(name));

  const showError = (field, show) => {
    field.setAttribute('aria-invalid', String(show));
    form.querySelector(`[data-error-for="${field.name}"]`).hidden = !show;
  };

  fields.forEach((field) => {
    showError(field, false);
    // Re-check a field once the visitor has left it, so errors don't appear while typing.
    field.addEventListener('blur', () => {
      if (field.value) showError(field, !field.checkValidity());
    });
    field.addEventListener('input', () => {
      if (field.getAttribute('aria-invalid') === 'true') showError(field, !field.checkValidity());
    });
  });

  const setStatus = (html, tone) => {
    status.innerHTML = html;
    status.dataset.tone = tone;
  };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    const invalid = fields.filter((field) => !field.checkValidity());
    fields.forEach((field) => showError(field, invalid.includes(field)));
    if (invalid.length) {
      setStatus(messages.invalid, 'error');
      invalid[0].focus();
      return;
    }

    button.disabled = true;
    buttonLabel.textContent = messages.sending;
    setStatus('', 'info');

    try {
      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(new FormData(form)).toString(),
      });
      if (!response.ok) throw new Error(String(response.status));
      form.reset();
      setStatus(messages.success, 'success');
    } catch {
      setStatus(
        `${messages.failure} <a href="${linkedin}" target="_blank" rel="noopener noreferrer">LinkedIn</a>.`,
        'error',
      );
    } finally {
      button.disabled = false;
      buttonLabel.textContent = messages.submit;
    }
  });
</script>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    background: var(--white);
  }

  /* Black-and-white photo on a white wall, anchored right; the edges fade into the white section */
  .contact__photo {
    position: absolute;
    top: 0;
    right: 0;
    width: auto;
    max-width: 62%;
    height: min(100%, 900px);
    object-fit: cover;
    object-position: center top;
    mask-image: linear-gradient(90deg, transparent, #000 22%), linear-gradient(0deg, transparent, #000 18%);
    mask-composite: intersect;
  }

  .contact__inner {
    position: relative;
    padding-block: clamp(40px, 6vw, 80px);
  }

  .contact__panel {
    display: grid;
    gap: 18px;
    width: min(100%, 560px);
    padding: clamp(28px, 4vw, 48px);
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .contact__title {
    color: var(--purple);
    font-size: clamp(34px, 4vw, 52px);
    font-weight: var(--fw-bold);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .contact__intro {
    font-size: 16px;
    font-weight: var(--fw-light);
  }

  /* Formulario */
  .form {
    display: grid;
    gap: 18px;
    margin-top: 8px;
  }

  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .field {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .field label,
  .field legend {
    color: var(--ink);
    font-size: 14px;
    font-weight: var(--fw-medium);
  }

  .field legend {
    margin-bottom: 8px;
    padding: 0;
  }

  .field__optional,
  .field__hint {
    color: var(--muted);
    font-size: 13px;
    font-weight: var(--fw-light);
  }

  .field input,
  .field textarea {
    width: 100%;
    min-height: 50px;
    padding: 12px 16px;
    border: 1.5px solid var(--line);
    border-radius: 8px;
    background: var(--white);
    color: var(--ink);
    font-family: var(--font);
    font-size: 16px;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .field textarea {
    min-height: 150px;
    resize: vertical;
  }

  .field input:hover,
  .field textarea:hover {
    border-color: var(--purple-24);
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--purple);
    box-shadow: 0 0 0 4px var(--purple-12);
  }

  .field [aria-invalid='true'] {
    border-color: var(--fuchsia);
    box-shadow: 0 0 0 4px var(--fuchsia-12);
  }

  .field__error {
    color: var(--fuchsia);
    font-size: 13px;
    font-weight: var(--fw-medium);
  }

  .field__error[hidden] {
    display: none;
  }

  /* Topic chips */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    position: relative;
    cursor: pointer;
  }

  .chip input {
    position: absolute;
    opacity: 0;
  }

  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 18px;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    font-size: 14px;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .chip:hover span {
    border-color: var(--purple);
  }

  .chip input:checked + span {
    border-color: var(--purple);
    background: var(--purple);
    color: var(--white);
  }

  .chip input:focus-visible + span {
    outline: 3px solid var(--fuchsia);
    outline-offset: 2px;
  }

  .form__submit {
    width: 100%;
  }

  .form__submit:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  .form__status:empty {
    display: none;
  }

  .form__status {
    padding: 14px 16px;
    border-radius: 8px;
    font-size: 14px;
  }

  .form__status[data-tone='success'] {
    background: var(--purple-12);
    color: var(--purple);
  }

  .form__status[data-tone='error'] {
    background: var(--fuchsia-12);
    color: var(--ink);
  }

  .form__status :global(a) {
    color: var(--purple);
    font-weight: var(--fw-semibold);
  }

  /* Otras vías */
  .contact__alt {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 8px;
    padding: 20px 0 0;
    border-top: 1px solid var(--panel-line);
    list-style: none;
  }

  .contact__alt a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    font-size: 13px;
    line-height: 1.4;
    text-decoration: none;
  }

  .contact__alt img {
    flex: none;
    width: 38px;
    height: auto;
  }

  .contact__alt strong {
    display: block;
    color: var(--purple);
    font-size: 15px;
  }

  .contact__alt a:hover strong {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact__place {
    color: var(--muted);
    font-size: 13px;
    font-weight: var(--fw-light);
  }

  @media (max-width: 900px) {
    .contact {
      display: flex;
      flex-direction: column;
    }

    .contact__photo {
      position: static;
      order: 2;
      width: 100%;
      max-width: none;
      height: 380px;
      margin-bottom: -60px;
      object-position: center top;
      mask-image: linear-gradient(0deg, transparent, #000 30%);
    }

    .contact__inner {
      padding-block: 24px 40px;
    }

    .contact__panel {
      width: 100%;
      padding: 24px 20px;
    }
  }

  @media (max-width: 560px) {
    .form__row,
    .contact__alt {
      grid-template-columns: 1fr;
    }
  }
</style>

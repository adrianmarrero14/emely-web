---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from './Base.astro';
import CtaBar from '../components/CtaBar.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { projects } from '../data/site';

interface Props {
  slug: string;
  name: string;
  tagline: string;
  cover: ImageMetadata;
  /** Two or three sentences that tell the whole story at a glance. */
  description: string;
  brief: string;
  details: { label: string; value: string }[];
  /** Table of contents; each `id` must match a <CaseSection id>. */
  sections: { id: string; title: string }[];
}

const { slug, name, tagline, cover, description, brief, details, sections } = Astro.props;

const published = projects.filter((project) => project.href);
const index = published.findIndex((project) => project.slug === slug);
const next = published[(index + 1) % published.length];
---

<Base title={`${name}, caso de estudio`} description={`${tagline} ${description}`}>
  <header class="case-hero">
    <div class="container case-hero__inner">
      <a class="case-hero__back" href="/proyectos">
        <ArrowIcon direction="left" />
        Todos los proyectos
      </a>
      <p class="eyebrow case-hero__eyebrow">Caso de estudio</p>
      <h1 class="title-xl case-hero__title">{name}</h1>
      <p class="case-hero__tagline">{tagline}</p>
      <dl class="case-hero__meta">
        {
          details.map((detail) => (
            <div>
              <dt>{detail.label}</dt>
              <dd>{detail.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </header>

  <div class="container case-cover">
    <Image
      src={cover}
      alt={`Pantallas del proyecto ${name}`}
      widths={[640, 1024, 1600]}
      sizes="(max-width: 1440px) 92vw, 1200px"
      loading="eager"
    />
  </div>

  <section class="container case-summary" aria-label="Resumen">
    <div class="case-summary__item">
      <h2>Descripción</h2>
      <p>{description}</p>
    </div>
    <div class="case-summary__item case-summary__item--brief">
      <h2>El encargo</h2>
      <p>{brief}</p>
    </div>
  </section>

  <div class="container case-layout">
    <nav class="case-toc" aria-label="Contenido del caso">
      <p class="case-toc__title">En este caso</p>
      <ol>
        {
          sections.map((section, i) => (
            <li>
              <a href={`#${section.id}`} data-toc-link={section.id}>
                <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {section.title}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <article class="case-body">
      <slot />
    </article>
  </div>

  {
    next && next.slug !== slug && (
      <nav class="case-next" aria-label="Siguiente proyecto">
        <a class="container case-next__link" href={next.href}>
          <span class="case-next__label">Siguiente caso de estudio</span>
          <span class="case-next__name">
            {next.name} <ArrowIcon />
          </span>
          <span class="case-next__summary">{next.summary}</span>
        </a>
      </nav>
    )
  }

  <CtaBar showProjects={false} />
</Base>

<script>
  // Highlight the table-of-contents entry for the section being read.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')].map((link) => [link.dataset.tocLink, link]),
  );
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((link) => link.removeAttribute('aria-current'));
        links.get(entry.target.id)?.setAttribute('aria-current', 'true');
      });
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );
  links.forEach((_, id) => {
    const section = id && document.getElementById(id);
    if (section) observer.observe(section);
  });
</script>

<style>
  /* Cabecera */
  .case-hero {
    position: relative;
    overflow: hidden;
    padding-block: 40px 200px;
    background: var(--purple);
    color: var(--white);
  }

  /* Fuchsia block echoing the duotone banners of the Figma design */
  .case-hero::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 22%;
    height: 100%;
    background: var(--fuchsia);
  }

  .case-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: start;
    gap: 16px;
  }

  .case-hero__back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 32px;
    font-size: 14px;
    font-weight: var(--fw-medium);
    text-decoration: none;
  }

  .case-hero__back:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .case-hero__eyebrow {
    color: var(--white);
  }

  .case-hero__title {
    color: var(--white);
  }

  .case-hero__tagline {
    max-width: 680px;
    font-size: clamp(18px, 1.8vw, 24px);
    font-weight: var(--fw-light);
    line-height: 1.45;
  }

  .case-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    margin-top: 16px;
  }

  .case-hero__meta dt {
    font-size: 12px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .case-hero__meta dd {
    font-size: 15px;
    font-weight: var(--fw-semibold);
  }

  .case-cover {
    position: relative;
    max-width: calc(var(--content-width) + 2 * var(--gutter));
    margin-top: -150px;
  }

  .case-cover img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  /* Resumen */
  .case-summary {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 24px;
    max-width: calc(var(--content-width) + 2 * var(--gutter));
    padding-block: 56px 24px;
  }

  .case-summary__item {
    padding: 28px 32px;
    border-radius: var(--radius);
    background: var(--surface);
  }

  .case-summary__item--brief {
    background: var(--purple);
    color: var(--white);
  }

  .case-summary__item h2 {
    margin-bottom: 8px;
    color: var(--purple);
    font-size: 13px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .case-summary__item--brief h2 {
    color: var(--white);
    opacity: 0.8;
  }

  .case-summary__item--brief p {
    font-size: 17px;
    font-weight: var(--fw-medium);
    line-height: 1.55;
  }

  /* Índice + contenido */
  .case-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    max-width: calc(var(--content-width) + 2 * var(--gutter));
    padding-bottom: 96px;
  }

  .case-toc {
    position: sticky;
    top: 24px;
    align-self: start;
    padding-top: 48px;
  }

  .case-toc__title {
    margin-bottom: 12px;
    color: var(--muted);
    font-size: 12px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .case-toc ol {
    display: grid;
    gap: 2px;
    padding: 0;
    list-style: none;
    border-left: 2px solid var(--line);
  }

  .case-toc a {
    display: flex;
    gap: 10px;
    margin-left: -2px;
    padding: 7px 0 7px 14px;
    border-left: 2px solid transparent;
    color: var(--text);
    font-size: 14px;
    line-height: 1.4;
    text-decoration: none;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .case-toc a span {
    color: var(--fuchsia);
    font-weight: var(--fw-semibold);
  }

  .case-toc a:hover,
  .case-toc a[aria-current='true'] {
    border-color: var(--purple);
    color: var(--purple);
    font-weight: var(--fw-medium);
  }

  /* Contenido largo de cada caso */
  .case-body {
    min-width: 0;
    font-size: 16px;
    line-height: 1.75;
  }

  .case-body :global(p + p) {
    margin-top: 14px;
  }

  .case-body :global(strong) {
    color: var(--ink);
  }

  .case-body :global(figure img),
  .case-body :global(.gallery img) {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .case-body :global(figcaption) {
    margin-top: 10px;
    color: var(--muted);
    font-size: 13px;
    font-weight: var(--fw-light);
    text-align: center;
  }

  .case-body :global(.gallery) {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    align-items: start;
    gap: 16px;
  }

  /* Bulleted lists inside case studies */
  .case-body :global(.list) {
    display: grid;
    gap: 10px;
    padding-left: 22px;
  }

  .case-body :global(.list li::marker) {
    color: var(--fuchsia);
  }

  /* Highlighted statement */
  .case-body :global(.callout) {
    padding: 20px 24px;
    border-left: 4px solid var(--fuchsia);
    border-radius: 0 8px 8px 0;
    background: var(--fuchsia-12);
    color: var(--ink);
    font-weight: var(--fw-medium);
  }

  /* Cards in a grid: problems, solutions, impact */
  .case-body :global(.cards) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    padding: 0;
    list-style: none;
  }

  .case-body :global(.card) {
    padding: 22px 22px 24px;
    border: 1px solid var(--line);
    border-top: 4px solid var(--purple);
    border-radius: 8px;
    background: var(--white);
    font-size: 15px;
    line-height: 1.6;
  }

  .case-body :global(.card:nth-child(even)) {
    border-top-color: var(--fuchsia);
  }

  .case-body :global(.card h4) {
    margin-bottom: 6px;
    color: var(--purple);
    font-size: 16px;
    font-weight: var(--fw-semibold);
  }

  /* Numbers from research */
  .case-body :global(.stats) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    padding: 0;
    list-style: none;
  }

  .case-body :global(.stat) {
    padding: 20px;
    border-radius: 8px;
    background: var(--purple-06);
    font-size: 14px;
    line-height: 1.5;
  }

  .case-body :global(.stat strong) {
    display: block;
    color: var(--purple);
    font-size: 36px;
    font-weight: var(--fw-bold);
    line-height: 1.1;
  }

  .case-body :global(.stat:nth-child(even) strong) {
    color: var(--fuchsia);
  }

  .case-body :global(.stat span) {
    display: block;
    margin-bottom: 6px;
    color: var(--ink);
    font-size: 12px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* User persona */
  .case-body :global(.persona) {
    display: grid;
    grid-template-columns: minmax(0, 260px) 1fr;
    align-items: start;
    gap: 28px;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--surface);
  }

  .case-body :global(.persona img) {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .case-body :global(.persona h4) {
    color: var(--purple);
    font-size: 22px;
    font-weight: var(--fw-semibold);
  }

  .case-body :global(.facts) {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 4px 16px;
    margin-top: 12px;
    font-size: 14px;
  }

  .case-body :global(.facts dt) {
    color: var(--muted);
    font-weight: var(--fw-medium);
  }

  /* Embedded Figma prototype */
  .case-body :global(.prototype) {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .case-body :global(.prototype iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Siguiente proyecto */
  .case-next {
    background: var(--purple-06);
  }

  .case-next__link {
    display: grid;
    gap: 6px;
    padding-block: 56px;
    text-decoration: none;
  }

  .case-next__label {
    color: var(--fuchsia);
    font-size: 13px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .case-next__name {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    color: var(--purple);
    font-size: clamp(28px, 3.3vw, 44px);
    font-weight: var(--fw-bold);
  }

  .case-next__name svg {
    width: 28px;
    height: 21px;
    transition: transform 0.2s ease;
  }

  .case-next__link:hover .case-next__name svg {
    transform: translateX(8px);
  }

  .case-next__summary {
    max-width: 640px;
    font-weight: var(--fw-light);
  }

  @media (max-width: 1024px) {
    .case-layout {
      grid-template-columns: 1fr;
    }

    .case-toc {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .case-hero {
      padding-bottom: 120px;
    }

    .case-cover {
      margin-top: -80px;
    }

    .case-summary {
      grid-template-columns: 1fr;
    }

    .case-summary__item {
      padding: 22px;
    }

    .case-body :global(.gallery) {
      grid-template-columns: 1fr;
    }

    .case-body :global(.persona) {
      grid-template-columns: 1fr;
    }

    .case-body :global(.persona img) {
      max-width: 260px;
    }

    .case-body :global(.prototype) {
      aspect-ratio: 9 / 14;
    }
  }
</style>

---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getLang, useTranslations } from '../i18n';

// Vertical editorial card: full-bleed photo, a dark fade at the bottom for the copy and a round arrow.
interface Props {
  name: string;
  image: ImageMetadata;
  /** object-position of the photo, to keep its subject inside the vertical crop. */
  focus?: string;
  /** Top-left tag, e.g. the sector. */
  tag?: string;
  summary?: string;
  /** Status line above the title, e.g. "Caso de estudio" or "En construcción". */
  status: string;
  /** Upcoming projects have no page yet: the card is not a link and its status dot pulses. */
  href?: string;
  headingLevel?: 'h2' | 'h3';
}

const { name, image, focus, tag, summary, status, href, headingLevel: Heading = 'h3' } = Astro.props;
const t = useTranslations(getLang(Astro.currentLocale));
---

<article class:list={['poster', { 'poster--linked': href, 'poster--upcoming': !href }]}>
  <Image
    class="poster__image"
    src={image}
    alt=""
    widths={[420, 640, 960]}
    sizes="(max-width: 760px) 78vw, (max-width: 1100px) 46vw, 390px"
    style={focus ? `object-position: ${focus}` : undefined}
  />
  <span class="poster__shade" aria-hidden="true"></span>

  {tag && <span class="poster__tag">{tag}</span>}

  <div class="poster__body">
    <p class="poster__status">{status}</p>
    <Heading class="poster__title">
      {
        href ? (
          <a href={href}>
            <span class="visually-hidden">{t('project.open')} </span>
            {name}
          </a>
        ) : (
          name
        )
      }
    </Heading>
    {summary && <p class="poster__summary">{summary}</p>}
  </div>

  {
    href && (
      <span class="poster__arrow" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="16" height="16" focusable="false">
          <path d="M4.5 11.5l7-7M5.5 4.5h6v6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    )
  }
</article>

<style>
  .poster {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--radius-lg);
    background: var(--ink);
    color: var(--white);
    box-shadow: 0 30px 60px -36px rgb(22 22 22 / 0.55);
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }

  .poster :global(.poster__image) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* Bottom fade in the darkest brand purple, so white text stays legible on any photo */
  .poster__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(22 0 40 / 0.35) 0%, transparent 24%),
      linear-gradient(0deg, rgb(22 0 40 / 0.96) 0%, rgb(34 0 64 / 0.86) 26%, rgb(51 0 96 / 0.45) 48%, transparent 68%);
  }

  .poster--upcoming .poster__shade {
    background:
      linear-gradient(180deg, rgb(22 0 40 / 0.35) 0%, transparent 24%),
      linear-gradient(0deg, rgb(22 0 40 / 0.94) 0%, rgb(34 0 64 / 0.7) 18%, rgb(51 0 96 / 0.3) 34%, transparent 52%);
  }

  .poster__tag {
    position: absolute;
    top: 18px;
    left: 18px;
    padding: 6px 12px;
    border: 1px solid var(--glass-line);
    border-radius: 999px;
    background: rgb(22 0 40 / 0.42);
    backdrop-filter: blur(10px);
    font-size: 12px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.02em;
  }

  .poster__body {
    display: grid;
    gap: 8px;
    padding: 0 76px 24px 24px;
  }

  .poster--upcoming .poster__body {
    padding-right: 24px;
  }

  .poster__status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .poster__status::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--fuchsia);
    box-shadow: 0 0 0 3px rgb(201 0 157 / 0.3);
  }

  .poster--upcoming .poster__status::before {
    animation: poster-pulse 2.4s ease-in-out infinite;
  }

  @keyframes poster-pulse {
    50% {
      box-shadow: 0 0 0 6px rgb(201 0 157 / 0);
    }
  }

  .poster__title {
    color: var(--white);
    font-size: clamp(24px, 2.2vw, 30px);
    font-weight: var(--fw-semibold);
    line-height: 1.15;
  }

  .poster__title a {
    color: inherit;
    text-decoration: none;
  }

  /* The whole card is the link target */
  .poster__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .poster__title a:focus-visible {
    outline: none;
  }

  .poster:has(.poster__title a:focus-visible) {
    outline: 3px solid var(--fuchsia);
    outline-offset: 4px;
  }

  .poster__summary {
    display: -webkit-box;
    overflow: hidden;
    font-size: 14px;
    font-weight: var(--fw-light);
    line-height: 1.55;
    opacity: 0.88;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  /* Minimal arrow in the bottom corner: outlined at rest, filled white on hover */
  .poster__arrow {
    position: absolute;
    right: 20px;
    bottom: 22px;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 50%;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease;
  }

  .poster__arrow svg {
    transition: transform 0.3s ease;
  }

  .poster--linked:hover,
  .poster--linked:focus-within {
    transform: translateY(-6px);
    box-shadow: 0 40px 70px -34px rgb(102 0 191 / 0.6);
  }

  .poster--linked:hover :global(.poster__image),
  .poster--linked:focus-within :global(.poster__image) {
    transform: scale(1.05);
  }

  .poster--linked:hover .poster__arrow,
  .poster--linked:focus-within .poster__arrow {
    border-color: var(--white);
    background: var(--white);
    color: var(--purple);
  }

  .poster--linked:hover .poster__arrow svg,
  .poster--linked:focus-within .poster__arrow svg {
    transform: rotate(45deg);
  }

  @media (max-width: 760px) {
    .poster__body {
      padding: 0 70px 20px 20px;
    }

    .poster__arrow {
      right: 18px;
      bottom: 20px;
    }
  }
</style>

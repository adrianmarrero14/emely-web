---
import { Image } from 'astro:assets';
import ArrowIcon from './ArrowIcon.astro';
import contactPhoto from '../assets/figma/contact-photo.png';
import { site } from '../data/site';
---

<section class="contact-block" aria-labelledby="contact-block-title">
  <Image
    class="contact-block__photo"
    src={contactPhoto}
    alt=""
    widths={[760, contactPhoto.width]}
    sizes="100vw"
  />
  <div class="container contact-block__copy">
    <p class="eyebrow">Contacto</p>
    <h2 id="contact-block-title" class="contact-block__title">¡Mándame un mensaje!</h2>
    <p class="contact-block__text">
      ¿Tienes un proyecto en mente, una vacante o simplemente quieres conversar sobre diseño? Me encantará leerte.
    </p>
    <a class="btn" href="/contacto">Escribirme <ArrowIcon /></a>

    <div class="contact-block__social">
      <p>
        <strong>Sigue mi trayectoria.</strong> En mis redes comparto novedades, proyectos y oportunidades.
      </p>
      <ul>
        <li>
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
            <img src="/icons/linkedin-purple.svg" width="44.3852" height="44.3852" alt="" />
            LinkedIn
          </a>
        </li>
        <li>
          <a href={site.behance} target="_blank" rel="noopener noreferrer">
            <img src="/icons/behance-purple.svg" width="45.0577" height="45.0577" alt="" />
            Behance
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .contact-block {
    position: relative;
    min-height: clamp(560px, 49vw, 707px);
    overflow: hidden;
  }

  .contact-block__photo {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    min-height: 122%;
    object-fit: cover;
    object-position: right top;
  }

  .contact-block__copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding-block: clamp(64px, 9vw, 128px) 72px;
  }

  .contact-block__title {
    max-width: 520px;
    color: var(--purple);
    font-size: clamp(40px, 4.6vw, 64px);
    font-weight: var(--fw-bold);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .contact-block__text {
    max-width: 420px;
    font-size: 17px;
    font-weight: var(--fw-light);
  }

  .contact-block__social {
    max-width: 420px;
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }

  .contact-block__social strong {
    color: var(--ink);
  }

  .contact-block__social ul {
    display: flex;
    gap: 24px;
    margin-top: 14px;
    padding: 0;
    list-style: none;
  }

  .contact-block__social a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--purple);
    font-weight: var(--fw-semibold);
    text-decoration: none;
  }

  .contact-block__social a img {
    width: 36px;
    height: auto;
    transition: transform 0.2s ease;
  }

  .contact-block__social a:hover img {
    transform: scale(1.08);
  }

  @media (max-width: 900px) {
    .contact-block {
      display: flex;
      flex-direction: column-reverse;
    }

    .contact-block__photo {
      position: static;
      width: 100%;
      min-height: 0;
      height: 440px;
      margin-bottom: -80px;
      object-position: 85% top;
    }

    .contact-block__copy {
      padding-block: 56px;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import contactPhoto from '../assets/figma/contact-photo.png';
import { site } from '../data/site';
---

<section class="contact-block" aria-labelledby="contact-block-title">
  <Image
    class="contact-block__photo"
    src={contactPhoto}
    alt=""
    widths={[760, contactPhoto.width]}
    sizes="100vw"
  />
  <div class="container contact-block__copy">
    <h2 id="contact-block-title" class="heading contact-block__title">¡Mandame un mensaje!</h2>
    <img class="contact-block__logo" src="/icons/logo-stacked-180.svg" width="180" height="92.0712" alt="Emely Aponte" />
    <a class="arrow-link contact-block__email" href="/contacto">
      Escríbeme desde el formulario
      <img src="/icons/arrow-purple-30.svg" width="30" height="22.501" alt="" />
    </a>
    <div class="contact-block__social">
      <p>
        <strong>¡Descubre más sobre mi trayectoria profesional y proyectos en mis redes sociales!</strong>
        Conéctate conmigo para estar al tanto de novedades, contenido relevante y oportunidades interesantes.
      </p>
      <ul>
        <li>
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
            <img src="/icons/linkedin-purple.svg" width="44.3852" height="44.3852" alt="" />
            LinkedIn
          </a>
        </li>
        <li>
          <a href={site.behance} target="_blank" rel="noopener noreferrer">
            <img src="/icons/behance-purple.svg" width="45.0577" height="45.0577" alt="" />
            Behance
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .contact-block {
    position: relative;
    min-height: clamp(560px, 49vw, 707px);
    overflow: hidden;
    color: var(--text-strong);
  }

  .contact-block__photo {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    min-height: 122%;
    object-fit: cover;
    object-position: right top;
  }

  .contact-block__copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-block: clamp(64px, 11vw, 159px) 72px;
    padding-left: clamp(16px, 4.5vw, 65px);
  }

  .contact-block__title {
    max-width: 514px;
    font-size: clamp(44px, 5vw, 72px);
    line-height: 0.97;
  }

  .contact-block__logo {
    width: 180px;
    height: auto;
    margin-top: clamp(40px, 5vw, 67px);
  }

  .contact-block__email {
    margin-top: 32px;
    gap: 16px;
  }

  .contact-block__social {
    max-width: 420px;
    margin-top: 40px;
    font-size: 15px;
    color: var(--text);
  }

  .contact-block__social strong {
    display: block;
    margin-bottom: 4px;
    color: var(--purple-dark);
  }

  .contact-block__social ul {
    display: flex;
    gap: 24px;
    margin-top: 16px;
    padding: 0;
    list-style: none;
  }

  .contact-block__social a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--purple-dark);
    font-weight: 700;
    text-decoration: none;
  }

  .contact-block__social a img {
    width: 36px;
    height: auto;
  }

  .contact-block__social a:hover {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .contact-block {
      display: flex;
      flex-direction: column-reverse;
    }

    .contact-block__photo {
      position: static;
      width: 100%;
      min-height: 0;
      height: 440px;
      margin-bottom: -80px;
      object-position: 85% top;
    }

    .contact-block__copy {
      padding-block: 56px;
    }
  }
</style>

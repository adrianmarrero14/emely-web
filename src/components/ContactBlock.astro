---
import { Image } from 'astro:assets';
import ArrowIcon from './ArrowIcon.astro';
import contactPhoto from '../assets/photos/contact-home.jpg';
import { site } from '../data/site';
import { getLang, path, useTranslations } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="contact-block" aria-labelledby="contact-block-title">
  <Image
    class="contact-block__photo"
    src={contactPhoto}
    alt=""
    widths={[700, 1100, contactPhoto.width]}
    sizes="(max-width: 900px) 100vw, 55vw"
  />
  <div class="container contact-block__copy">
    <div class="panel contact-block__card">
      <p class="eyebrow">{t('contactBlock.eyebrow')}</p>
      <h2 id="contact-block-title" class="contact-block__title">{t('contactBlock.title')}</h2>
      <p class="contact-block__text">{t('contactBlock.text')}</p>
      <div class="actions">
        <a class="btn" href={path('contact', lang)}>{t('contactBlock.button')} <ArrowIcon /></a>
      </div>

      <div class="contact-block__social">
        <p>
          <strong>{t('contactBlock.followTitle')}</strong> {t('contactBlock.followText')}
        </p>
        <ul>
          <li>
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
              <img src="/icons/linkedin-purple.svg" width="44.3852" height="44.3852" alt="" />
              LinkedIn
            </a>
          </li>
          <li>
            <a href={site.behance} target="_blank" rel="noopener noreferrer">
              <img src="/icons/behance-purple.svg" width="45.0577" height="45.0577" alt="" />
              Behance
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-block {
    position: relative;
    min-height: clamp(560px, 49vw, 707px);
    overflow: hidden;
    background: var(--white);
  }

  /* Black-and-white photo on a white wall, anchored right; the edges fade into the white section */
  .contact-block__photo {
    position: absolute;
    top: 0;
    right: 0;
    width: auto;
    max-width: 62%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    mask-image: linear-gradient(90deg, transparent, #000 22%), linear-gradient(0deg, transparent, #000 18%);
    mask-composite: intersect;
  }

  .contact-block__copy {
    position: relative;
    padding-block: clamp(56px, 8vw, 112px) 72px;
  }

  .contact-block__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: 520px;
    padding: clamp(28px, 4vw, 48px);
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .contact-block__title {
    max-width: 520px;
    color: var(--purple);
    font-size: clamp(40px, 4.6vw, 64px);
    font-weight: var(--fw-bold);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .contact-block__text {
    max-width: 420px;
    font-size: 17px;
    font-weight: var(--fw-light);
  }

  .contact-block__social {
    max-width: 420px;
    width: 100%;
    margin-top: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--panel-line);
    font-size: 14px;
  }

  .contact-block__social strong {
    color: var(--ink);
  }

  .contact-block__social ul {
    display: flex;
    gap: 24px;
    margin-top: 14px;
    padding: 0;
    list-style: none;
  }

  .contact-block__social a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--purple);
    font-weight: var(--fw-semibold);
    text-decoration: none;
  }

  .contact-block__social a img {
    width: 36px;
    height: auto;
    transition: transform 0.2s ease;
  }

  .contact-block__social a:hover img {
    transform: scale(1.08);
  }

  @media (max-width: 900px) {
    .contact-block {
      display: flex;
      flex-direction: column-reverse;
    }

    .contact-block__photo {
      position: static;
      width: 100%;
      max-width: none;
      height: 440px;
      margin-bottom: -80px;
      object-position: center top;
      mask-image: linear-gradient(0deg, transparent, #000 30%);
    }

    .contact-block__copy {
      padding-block: 40px 24px;
    }

    .contact-block__card {
      max-width: none;
    }
  }
</style>

---
import ArrowIcon from './ArrowIcon.astro';
import { getLang, path, useTranslations } from '../i18n';

interface Props {
  /** Hide the "see projects" half when the page is already about projects. */
  showProjects?: boolean;
}

const { showProjects = true } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class:list={['cta', { 'cta--single': !showProjects }]} aria-label={t('cta.label')}>
  <a class="cta__item cta__item--message" href={path('contact', lang)}>
    <span class="cta__kicker">{t('cta.talk')}</span>
    <span class="cta__label">{t('cta.message')} <ArrowIcon /></span>
  </a>
  {
    showProjects && (
      <a class="cta__item cta__item--projects" href={path('projects', lang)}>
        <span class="cta__kicker">{t('cta.more')}</span>
        <span class="cta__label">{t('cta.projects')} <ArrowIcon /></span>
      </a>
    )
  }
</section>

<style>
  .cta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    color: var(--white);
  }

  .cta--single {
    grid-template-columns: 1fr;
  }

  .cta__item {
    display: grid;
    align-content: center;
    gap: 6px;
    min-height: 160px;
    padding-block: 32px;
    /* Each half is 50% wide, so (100% - content / 2) puts the text on the container edge */
    padding-inline: max(var(--gutter), calc(100% - var(--content-width) / 2)) var(--gutter);
    text-decoration: none;
  }

  .cta__item--projects {
    padding-inline: var(--gutter) max(var(--gutter), calc(100% - var(--content-width) / 2));
  }

  .cta--single .cta__item {
    padding-inline: var(--edge);
  }

  .cta__item--message {
    background: var(--fuchsia);
  }

  .cta__item--projects {
    background: var(--purple);
  }

  .cta__kicker {
    font-size: 14px;
    font-weight: var(--fw-light);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cta__label {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: clamp(24px, 2.6vw, 36px);
    font-weight: var(--fw-semibold);
    line-height: 1.2;
  }

  .cta__label svg {
    width: 26px;
    height: 20px;
    transition: transform 0.2s ease;
  }

  .cta__item:hover .cta__label svg,
  .cta__item:focus-visible .cta__label svg {
    transform: translateX(6px);
  }

  .cta__item:focus-visible {
    outline-color: var(--white);
    outline-offset: -8px;
  }

  @media (max-width: 760px) {
    .cta {
      grid-template-columns: 1fr;
    }

    .cta__item,
    .cta__item--projects {
      min-height: 128px;
      padding-inline: var(--gutter);
    }
  }
</style>

---
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  /** Hide the "see projects" half when the page is already about projects. */
  showProjects?: boolean;
}

const { showProjects = true } = Astro.props;
---

<section class:list={['cta', { 'cta--single': !showProjects }]} aria-label="Siguientes pasos">
  <a class="cta__item cta__item--message" href="/contacto">
    <span class="cta__kicker">¿Hablamos?</span>
    <span class="cta__label">Envíame un mensaje <ArrowIcon /></span>
  </a>
  {
    showProjects && (
      <a class="cta__item cta__item--projects" href="/proyectos">
        <span class="cta__kicker">¿Quieres ver más?</span>
        <span class="cta__label">Explora mis proyectos <ArrowIcon /></span>
      </a>
    )
  }
</section>

<style>
  .cta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    color: var(--white);
  }

  .cta--single {
    grid-template-columns: 1fr;
  }

  .cta__item {
    display: grid;
    align-content: center;
    gap: 6px;
    min-height: 160px;
    padding: 32px var(--gutter);
    text-decoration: none;
  }

  .cta__item--message {
    background: var(--fuchsia);
  }

  .cta__item--projects {
    background: var(--purple);
  }

  .cta__kicker {
    font-size: 14px;
    font-weight: var(--fw-light);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cta__label {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: clamp(24px, 2.6vw, 36px);
    font-weight: var(--fw-semibold);
    line-height: 1.2;
  }

  .cta__label svg {
    width: 26px;
    height: 20px;
    transition: transform 0.2s ease;
  }

  .cta__item:hover .cta__label svg,
  .cta__item:focus-visible .cta__label svg {
    transform: translateX(6px);
  }

  .cta__item:focus-visible {
    outline-color: var(--white);
    outline-offset: -8px;
  }

  @media (max-width: 760px) {
    .cta {
      grid-template-columns: 1fr;
    }

    .cta__item {
      min-height: 128px;
    }
  }
</style>

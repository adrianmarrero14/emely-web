---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  /** Wide layout shown on tablets and desktops. */
  desktop: ImageMetadata;
  /** Tall layout of the same content for phones. */
  mobile: ImageMetadata;
  alt: string;
}

const { desktop, mobile, alt } = Astro.props;
const [wide, tall] = await Promise.all([
  getImage({ src: desktop, width: Math.min(desktop.width, 1760), format: 'webp' }),
  getImage({ src: mobile, width: Math.min(mobile.width, 800), format: 'webp' }),
]);
---

<figure>
  <picture>
    <source media="(max-width: 760px)" srcset={tall.src} width={tall.attributes.width} height={tall.attributes.height} />
    <img src={wide.src} width={wide.attributes.width} height={wide.attributes.height} alt={alt} loading="lazy" decoding="async" />
  </picture>
</figure>

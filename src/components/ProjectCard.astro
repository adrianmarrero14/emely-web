---
import { Image } from 'astro:assets';
import ArrowIcon from './ArrowIcon.astro';
import type { Project } from '../data/site';

interface Props {
  project: Project;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel: Heading = 'h3' } = Astro.props;
---

<article class:list={['project-card', { 'project-card--linked': project.href }]}>
  <div class="project-card__media">
    <Image
      src={project.cover}
      alt=""
      widths={[480, 800, 1200]}
      sizes="(max-width: 760px) 92vw, (max-width: 1200px) 46vw, 560px"
    />
  </div>
  <div class="project-card__body">
    <span class="tag">{project.category}</span>
    <Heading class="project-card__title">
      {project.href ? <a href={project.href}>{project.name}</a> : project.name}
    </Heading>
    <p class="project-card__summary">{project.summary}</p>
    {
      project.href ? (
        <span class="link-arrow project-card__cta" aria-hidden="true">
          Ver caso de estudio <ArrowIcon />
        </span>
      ) : (
        <p class="project-card__status">{project.status}</p>
      )
    }
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .project-card--linked:hover,
  .project-card--linked:focus-within {
    transform: translateY(-4px);
    box-shadow: 0 26px 50px -20px rgb(22 22 22 / 0.45);
  }

  .project-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface);
  }

  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .project-card--linked:hover .project-card__media img {
    transform: scale(1.04);
  }

  .project-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 24px 26px 28px;
    border-top: 4px solid var(--fuchsia);
  }

  .project-card__title {
    margin-top: 4px;
    font-size: 22px;
    font-weight: var(--fw-semibold);
  }

  .project-card__title a {
    text-decoration: none;
  }

  /* The whole card is the link target */
  .project-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .project-card__title a:focus-visible {
    outline: none;
  }

  .project-card:has(.project-card__title a:focus-visible) {
    outline: 3px solid var(--fuchsia);
    outline-offset: 4px;
  }

  .project-card__summary {
    color: var(--text);
    font-size: 15px;
  }

  .project-card__cta,
  .project-card__status {
    margin-top: auto;
    padding-top: 8px;
    font-size: 15px;
  }

  .project-card__status {
    color: var(--muted);
    font-weight: var(--fw-light);
    font-style: italic;
  }
</style>

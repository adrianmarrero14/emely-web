---
import { Image } from 'astro:assets';
import { projects } from '../data/site';
---

<section class="projects" aria-label="Proyectos en los que he trabajado" data-carousel>
  <ul class="projects__track" data-track>
    {
      projects.map((project, index) => (
        <li class:list={['projects__tile', index % 2 ? 'projects__tile--purple' : 'projects__tile--magenta']}>
          <article class="project-card">
            <Image
              class="project-card__image"
              src={project.cover}
              alt={`Pantallas del proyecto ${project.name}`}
              widths={[480, 800]}
              sizes="(max-width: 760px) 80vw, 30vw"
            />
            <h3 class="project-card__name">{project.name}</h3>
            <p class="project-card__intro">
              {project.intro[0]} <strong>{project.intro[1]}</strong> {project.intro[2]}
            </p>
            {project.href ? (
              <a class="arrow-link project-card__link" href={project.href}>
                Ver caso de estudio
                <img src="/icons/arrow-white-20.svg" width="20" height="15.0007" alt="" />
              </a>
            ) : (
              <p class="project-card__soon">Caso de estudio próximamente</p>
            )}
          </article>
        </li>
      ))
    }
  </ul>

  <button type="button" class="projects__nav projects__nav--prev" aria-label="Proyecto anterior" data-prev>
    <img src="/icons/chevron-left.svg" width="35.4029" height="60.3164" alt="" />
  </button>
  <button type="button" class="projects__nav projects__nav--next" aria-label="Proyecto siguiente" data-next>
    <img src="/icons/chevron-right.svg" width="35.4028" height="60.3164" alt="" />
  </button>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-track]')!;
    const prev = carousel.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = carousel.querySelector<HTMLButtonElement>('[data-next]')!;

    const step = () => track.querySelector<HTMLElement>('li')?.offsetWidth ?? track.clientWidth;
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
      carousel.dataset.scrollable = String(max > 0);
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  .projects {
    position: relative;
    color: var(--white);
  }

  .projects__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc(100% / 3);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .projects__track::-webkit-scrollbar {
    display: none;
  }

  .projects__tile {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: clamp(520px, 39.6vw, 571px);
    padding: 64px clamp(56px, 6vw, 90px);
    scroll-snap-align: start;
  }

  .projects__tile--magenta {
    background: var(--magenta);
  }

  .projects__tile--purple {
    background: var(--purple);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    width: 100%;
    max-width: 320px;
  }

  .project-card__image {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    margin-bottom: 10px;
    box-shadow: 0 18px 40px rgba(40, 0, 70, 0.35);
  }

  .project-card__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 36px;
    line-height: 1.1;
  }

  .project-card__intro {
    font-size: 16px;
  }

  .project-card__link,
  .project-card__soon {
    margin-top: 6px;
    font-size: 16px;
  }

  .project-card__soon {
    opacity: 0.75;
    font-style: italic;
  }

  .projects__nav {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 56px;
    height: 80px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transform: translateY(-50%);
    transition: opacity 0.2s ease;
  }

  .projects__nav img {
    width: 29px;
    height: auto;
  }

  .projects__nav--prev {
    left: clamp(4px, 1.4vw, 20px);
  }

  .projects__nav--prev img {
    transform: scaleX(-1);
  }

  .projects__nav--next {
    right: clamp(4px, 1.4vw, 20px);
  }

  .projects__nav:disabled {
    opacity: 0.35;
    cursor: default;
  }

  [data-scrollable='false'] .projects__nav {
    display: none;
  }

  @media (max-width: 1024px) {
    .projects__track {
      grid-auto-columns: 50%;
    }
  }

  @media (max-width: 760px) {
    .projects__track {
      grid-auto-columns: 100%;
    }

    .projects__tile {
      min-height: 0;
      padding: 56px 64px;
    }
  }
</style>

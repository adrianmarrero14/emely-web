---
import { nav } from '../data/site';
import { getAlternates, getLang, languages, path as localizedPath, useTranslations } from '../i18n';

interface Props {
  /** `overlay` sits on top of the home hero in white; `solid` is the white bar of the inner pages. */
  variant?: 'overlay' | 'solid';
}

const { variant = 'solid' } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const trim = (href: string) => href.replace(/\/$/, '') || '/';
const path = trim(Astro.url.pathname);
const home = trim(localizedPath('home', lang));
const isActive = (href: string) => (trim(href) === home ? path === home : path.startsWith(trim(href)));
const links = nav.map((item) => ({ href: localizedPath(item.route, lang), label: t(item.label) }));
const alternates = getAlternates(Astro.url.pathname);
---

<header class:list={['site-header', `site-header--${variant}`]} data-header>
  <div class="site-header__inner">
    <a href={localizedPath('home', lang)} class="site-header__logo">
      <img
        src={variant === 'overlay' ? '/icons/logo-white.svg' : '/icons/logo-horizontal.svg'}
        width="246.4"
        height="34.02"
        alt={t('nav.logo')}
      />
    </a>
    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
      data-open-label={t('nav.open')}
      data-close-label={t('nav.close')}
    >
      <span class="visually-hidden" data-nav-label>{t('nav.open')}</span>
      <span class="site-header__burger" aria-hidden="true"></span>
    </button>
    <nav id="site-nav" class="site-header__nav" aria-label={t('nav.main')}>
      <ul>
        {
          links.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={{ 'is-active': isActive(item.href) }}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <!-- Language switcher: each option points to this same page in the other language -->
      <div class="lang-switch" role="group" aria-label={t('lang.label')}>
        {
          alternates.map((alternate) => (
            <a
              class:list={['lang-switch__option', { 'is-current': alternate.lang === lang }]}
              href={alternate.href}
              hreflang={alternate.lang}
              lang={alternate.lang}
              aria-current={alternate.lang === lang ? 'true' : undefined}
              title={alternate.translated ? undefined : t('lang.unavailable')}
            >
              <span aria-hidden="true">{languages[alternate.lang].label}</span>
              <span class="visually-hidden">{languages[alternate.lang].name}</span>
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const label = header?.querySelector<HTMLElement>('[data-nav-label]');

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = (open ? toggle?.dataset.closeLabel : toggle?.dataset.openLabel) ?? '';
    if (header) header.dataset.open = String(open);
    document.body.style.overflow = open ? 'hidden' : '';
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && header?.dataset.open === 'true') {
      setOpen(false);
      toggle?.focus();
    }
  });
  window.matchMedia('(min-width: 761px)').addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    height: var(--header-height);
    font-size: 15px;
  }

  .site-header--solid {
    border-bottom: 1px solid var(--line);
    background: var(--white);
    color: var(--ink);
  }

  .site-header--overlay {
    position: absolute;
    inset: 0 0 auto;
    color: var(--white);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    max-width: var(--container);
    height: 100%;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .site-header__logo {
    position: relative;
    z-index: 2;
    flex: none;
  }

  .site-header__logo img {
    width: 168px;
    height: auto;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.6vw, 40px);
  }

  .site-header__nav ul {
    display: flex;
    gap: clamp(20px, 2.6vw, 40px);
    padding: 0;
    list-style: none;
  }

  /* Language switcher: a quiet two-option pill that follows the header colour */
  .lang-switch {
    display: flex;
    padding: 3px;
    border: 1px solid color-mix(in srgb, currentColor 28%, transparent);
    border-radius: 999px;
    font-size: 12px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.06em;
  }

  .site-header__nav .lang-switch__option {
    display: grid;
    place-items: center;
    min-width: 34px;
    min-height: 26px;
    padding: 0 8px;
    border-radius: 999px;
    opacity: 0.75;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .site-header__nav .lang-switch__option::after {
    content: none;
  }

  .site-header__nav .lang-switch__option:hover {
    opacity: 1;
  }

  .site-header__nav .lang-switch__option.is-current {
    background: var(--purple);
    color: var(--white);
    opacity: 1;
  }

  .site-header--overlay .lang-switch__option.is-current {
    background: var(--white);
    color: var(--purple);
  }

  .site-header__nav a {
    position: relative;
    display: block;
    padding-block: 6px;
    font-weight: var(--fw-regular);
    text-decoration: none;
  }

  .site-header__nav a::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--fuchsia);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .site-header--overlay .site-header__nav a::after {
    background: currentColor;
  }

  .site-header__nav a:hover::after,
  .site-header__nav a.is-active::after {
    transform: scaleX(1);
  }

  .site-header__nav a.is-active {
    font-weight: var(--fw-semibold);
  }

  .site-header--solid .site-header__nav a.is-active {
    color: var(--purple);
  }

  .site-header__toggle {
    display: none;
  }

  @media (max-width: 760px) {
    .site-header__logo img {
      width: 140px;
    }

    .site-header__toggle {
      position: relative;
      z-index: 2;
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      margin-right: -10px;
      padding: 0;
      border: 0;
      background: none;
      color: inherit;
      cursor: pointer;
    }

    .site-header__burger,
    .site-header__burger::before,
    .site-header__burger::after {
      width: 24px;
      height: 2px;
      border-radius: 2px;
      background: currentColor;
      transition:
        transform 0.2s ease,
        background-color 0.2s ease;
    }

    .site-header__burger {
      position: relative;
    }

    .site-header__burger::before,
    .site-header__burger::after {
      content: '';
      position: absolute;
      left: 0;
    }

    .site-header__burger::before {
      top: -7px;
    }

    .site-header__burger::after {
      top: 7px;
    }

    [data-open='true'] .site-header__toggle {
      color: var(--white);
    }

    [data-open='true'] .site-header__burger {
      background: transparent;
    }

    [data-open='true'] .site-header__burger::before {
      transform: translateY(7px) rotate(45deg);
    }

    [data-open='true'] .site-header__burger::after {
      transform: translateY(-7px) rotate(-45deg);
    }

    /* Keep the logo legible on the purple menu */
    .site-header--solid[data-open='true'] .site-header__logo img {
      filter: brightness(0) invert(1);
    }

    .site-header__nav {
      position: fixed;
      inset: 0;
      flex-direction: column;
      justify-content: center;
      gap: 48px;
      background: var(--purple);
      color: var(--white);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.2s ease,
        visibility 0.2s;
    }

    [data-open='true'] .site-header__nav {
      opacity: 1;
      visibility: visible;
    }

    .site-header__nav ul {
      flex-direction: column;
      align-items: center;
      gap: 24px;
      font-size: 24px;
    }

    .site-header__nav a::after,
    .site-header--solid .site-header__nav a::after {
      background: var(--white);
    }

    .site-header--solid .site-header__nav a.is-active {
      color: var(--white);
    }

    .lang-switch {
      font-size: 15px;
    }

    .site-header__nav .lang-switch__option {
      min-width: 52px;
      min-height: 40px;
    }

    .site-header__nav .lang-switch__option.is-current {
      background: var(--white);
      color: var(--purple);
    }
  }
</style>

---
import { nav, site } from '../data/site';
import { getLang, path, useTranslations } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a href={path('home', lang)} class="site-footer__logo">
        <img src="/icons/logo-white.svg" width="246.4" height="34.02" alt={t('nav.logo')} />
      </a>
      <p>{t('footer.role')} · {t('site.location')}</p>
    </div>

    <nav aria-label={t('nav.footer')}>
      <ul class="site-footer__links">
        {nav.map((item) => <li><a href={path(item.route, lang)}>{t(item.label)}</a></li>)}
      </ul>
    </nav>

    <ul class="site-footer__social" aria-label={t('common.social')}>
      <li>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
          <img src="/icons/linkedin-white.svg" width="27" height="27" alt="" />
          LinkedIn
        </a>
      </li>
      <li>
        <a href={site.behance} target="_blank" rel="noopener noreferrer">
          <img src="/icons/behance-white.svg" width="27" height="27" alt="" />
          Behance
        </a>
      </li>
    </ul>
  </div>
  <div class="container site-footer__legal">
    <p>© {year} {site.name}. {t('footer.rights')}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--purple);
    color: var(--white);
    font-size: 14px;
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 32px;
    padding-block: 56px 40px;
  }

  .site-footer__logo img {
    width: 200px;
    height: auto;
  }

  .site-footer__brand p {
    margin-top: 14px;
    font-weight: var(--fw-light);
    opacity: 0.85;
  }

  .site-footer__links,
  .site-footer__social {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer__links a:hover,
  .site-footer__social a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: var(--fw-medium);
  }

  .site-footer__social img {
    width: 24px;
    height: 24px;
  }

  .site-footer__legal {
    padding-bottom: 28px;
    font-size: 13px;
    font-weight: var(--fw-light);
    opacity: 0.85;
  }

  /* Border on the paragraph so the line stops at the container edges */
  .site-footer__legal p {
    padding-top: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.2);
  }

  @media (max-width: 760px) {
    .site-footer__inner {
      grid-template-columns: 1fr 1fr;
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>

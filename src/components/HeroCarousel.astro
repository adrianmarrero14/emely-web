---
import { Image } from 'astro:assets';
import hero1 from '../assets/photos/hero-1.jpg';
import hero2 from '../assets/photos/hero-2.jpg';
import hero3 from '../assets/photos/hero-3.jpg';
import ArrowIcon from './ArrowIcon.astro';

// Black-and-white photos tinted in CSS, like the original Figma layers: two brand colours split by a darker band.
// Band edges (a, b) are fractions of the photo width on desktop and of the viewport on mobile; focus is the face,
// and lift raises the photo on mobile so the face stays above the headline.
const slides = [
  {
    image: hero1,
    label: 'Emely Aponte, Senior Product & UX/UI Designer',
    left: 'var(--purple)',
    right: 'var(--hero-fuchsia)',
    band: { a: 0.3, b: 0.46, aMobile: 0.1, bMobile: 0.32 },
    focus: '62% 28%',
    lift: '9%',
  },
  {
    image: hero2,
    label: 'Me encanta la creación de contenidos y las redes sociales',
    left: 'var(--hero-fuchsia)',
    right: 'var(--purple)',
    band: { a: 0.16, b: 0.34, aMobile: 0.06, bMobile: 0.28 },
    focus: '58% 24%',
    lift: '6%',
  },
  {
    image: hero3,
    label: 'Me apasiona el mundo gaming, las series y los cómics',
    left: 'var(--purple)',
    right: 'var(--hero-fuchsia)',
    band: { a: 0.12, b: 0.3, aMobile: 0.04, bMobile: 0.26 },
    focus: '68% 34%',
    lift: '14%',
  },
];
---

<section class="hero" aria-roledescription="carrusel" aria-label="Presentación" data-hero>
  <div class="hero__slides">
    {
      slides.map((slide, index) => (
        <div
          class:list={['hero__slide', `hero__slide--${index + 1}`, { 'is-active': index === 0 }]}
          role="group"
          aria-roledescription="diapositiva"
          aria-label={`${index + 1} de ${slides.length}`}
          aria-hidden={index === 0 ? undefined : 'true'}
          style={{
            '--ratio': slide.image.width / slide.image.height,
            '--left': slide.left,
            '--right': slide.right,
            '--a': slide.band.a,
            '--b': slide.band.b,
            '--a-mobile': slide.band.aMobile,
            '--b-mobile': slide.band.bMobile,
            '--focus': slide.focus,
            '--lift': slide.lift,
          }}
          data-slide
        >
          <div class="hero__stage">
            <Image
              class="hero__image"
              src={slide.image}
              alt=""
              widths={[700, 1000, 1400, slide.image.width]}
              sizes="(max-width: 760px) 700px, min(66vw, 940px)"
              loading="eager"
              fetchpriority={index === 0 ? 'high' : 'low'}
            />
            <span class="hero__tint" aria-hidden="true"></span>
          </div>
          <div class="hero__copy container">
            {index === 0 && (
              <h1 class="hero__title hero__title--main">
                <span class="hero__tag hero__tag--role">
                  Emely Aponte · <strong>Senior Product & UX/UI Designer</strong>
                </span>
                <span class="hero__headline">
                  Diseño experiencias digitales <em>end-to-end</em> que transforman procesos complejos en{' '}
                  <span class="highlight">interfaces intuitivas</span>.
                </span>
              </h1>
            )}
            {index === 1 && (
              <p class="hero__title">
                <span class="hero__big">Me encanta</span>
                <span class="hero__mid">la creación de contenidos</span>
                <span class="hero__tag">
                  y las redes <strong>sociales</strong>
                </span>
              </p>
            )}
            {index === 2 && (
              <p class="hero__title">
                <span class="hero__big">Me apasiona</span>
                <span class="hero__tag">
                  el mundo <strong>gaming</strong>
                </span>
                <span class="hero__mid">las series y los comics</span>
              </p>
            )}
          </div>
        </div>
      ))
    }
  </div>

  <div class="actions hero__actions container">
    <a class="btn btn--light" href="/proyectos">Ver proyectos <ArrowIcon /></a>
    <a class="btn btn--outline-light" href="/contacto">Hablemos</a>
  </div>

  <div class="hero__controls">
    <button type="button" class="hero__arrow" aria-label="Diapositiva anterior" data-prev>
      <ArrowIcon direction="left" />
    </button>
    <div class="hero__dots">
      {
        slides.map((slide, index) => (
          <button
            type="button"
            class:list={['hero__dot', { 'is-active': index === 0 }]}
            aria-label={`Ver diapositiva ${index + 1}: ${slide.label}`}
            aria-current={index === 0 ? 'true' : undefined}
            data-dot={index}
          />
        ))
      }
    </div>
    <button type="button" class="hero__arrow" aria-label="Diapositiva siguiente" data-next>
      <ArrowIcon />
    </button>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: number | undefined;

    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === current);
        if (i === current) slide.removeAttribute('aria-hidden');
        else slide.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === current);
        if (i === current) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    const stop = () => window.clearInterval(timer);
    const start = () => {
      if (reduceMotion) return;
      stop();
      timer = window.setInterval(() => show(current + 1), 6000);
    };

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        show(i);
        start();
      }),
    );
    hero.querySelector('[data-prev]')?.addEventListener('click', () => {
      show(current - 1);
      start();
    });
    hero.querySelector('[data-next]')?.addEventListener('click', () => {
      show(current + 1);
      start();
    });
    hero.addEventListener('mouseenter', stop);
    hero.addEventListener('mouseleave', start);
    hero.addEventListener('focusin', stop);
    hero.addEventListener('focusout', start);
    start();
  }
</script>

<style>
  .hero {
    --hero-fuchsia: #d500a6;
    --hero-band: #56007d;
    position: relative;
    height: clamp(600px, 59.4vw, 855px);
    overflow: hidden;
    background: var(--purple);
    color: var(--white);
  }

  .hero__slides,
  .hero__slide {
    position: absolute;
    inset: 0;
  }

  .hero__slide {
    isolation: isolate;
    background: var(--white);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.9s ease, visibility 0.9s;
  }

  .hero__slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* Full-height photo anchored to the right, so the head is never cropped on wide screens */
  .hero__stage {
    --band-a: var(--a);
    --band-b: var(--b);
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    aspect-ratio: var(--ratio);
    container-type: inline-size;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus);
    transform-origin: var(--focus);
    mask-image: linear-gradient(90deg, transparent, #000 16%);
  }

  /* One multiply layer recreates the Figma overlay: it reaches far left to colour the empty area,
     and --reveal grows the band across the photo when the slide comes in */
  .hero__tint {
    --band-start: calc(100vw + var(--band-a) * 100cqw);
    --band-end: calc(var(--band-start) + (var(--band-b) - var(--band-a)) * var(--reveal) * 100cqw);
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: -100vw;
    background: linear-gradient(
      90deg,
      var(--left) var(--band-start),
      var(--hero-band) var(--band-start) var(--band-end),
      var(--right) var(--band-end)
    );
    mix-blend-mode: multiply;
  }

  .hero__slide.is-active .hero__stage {
    animation: hero-band 1.2s cubic-bezier(0.65, 0, 0.35, 1) 0.3s both;
  }

  /* Slow push-out while the slide is on screen */
  .hero__slide.is-active .hero__image {
    animation: hero-zoom 9s cubic-bezier(0.2, 0.6, 0.3, 1) both;
  }

  .hero__slide.is-active .hero__title > * {
    animation: hero-rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero__slide.is-active .hero__title > :nth-child(1) {
    animation-delay: 0.25s;
  }

  .hero__slide.is-active .hero__title > :nth-child(2) {
    animation-delay: 0.4s;
  }

  .hero__slide.is-active .hero__title > :nth-child(3) {
    animation-delay: 0.55s;
  }

  @property --reveal {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }

  @keyframes hero-band {
    from {
      --reveal: 0;
    }
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1.07);
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  /* Bottom padding keeps the headline clear of the persistent buttons */
  .hero__copy {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
    padding-bottom: clamp(96px, 11vw, 160px);
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    color: var(--white);
    font-weight: var(--fw-bold);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .hero__kicker {
    font-size: clamp(26px, 3vw, 44px);
    font-weight: var(--fw-medium);
  }

  .hero__name {
    font-size: clamp(40px, 4.8vw, 68px);
    line-height: 1.1;
  }

  .hero__big {
    font-size: clamp(40px, 5vw, 72px);
  }

  .hero__mid {
    font-size: clamp(24px, 3.6vw, 52px);
    font-weight: var(--fw-semibold);
  }

  .hero__tag {
    margin-block: 0.25em;
    padding: 0.06em 0.28em;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.92);
    color: var(--ink);
    font-weight: var(--fw-light);
    font-size: clamp(20px, 2.7vw, 38px);
    letter-spacing: 0;
  }

  .hero__tag--small {
    margin-top: 0.4em;
    font-size: clamp(20px, 2.2vw, 32px);
  }

  .hero__tag strong {
    color: var(--purple);
    font-weight: var(--fw-semibold);
  }

  /* Slide 1: professional headline */
  .hero__title--main {
    gap: 22px;
    max-width: min(640px, 52%);
  }

  /* Glass chip, same treatment as the panels across the site */
  .hero__tag--role {
    margin: 0;
    padding: 8px 16px;
    border: 1px solid var(--glass-line);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.12);
    color: var(--white);
    font-size: clamp(13px, 1.1vw, 16px);
    font-weight: var(--fw-medium);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .hero__tag--role strong {
    color: var(--white);
  }

  .hero__headline {
    font-size: clamp(30px, 3.5vw, 52px);
    font-weight: var(--fw-bold);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero__headline em {
    font-style: normal;
    font-weight: var(--fw-light);
  }

  .hero__actions {
    position: absolute;
    right: 0;
    bottom: 24%;
    left: 0;
  }

  .hero__controls {
    position: absolute;
    left: 50%;
    bottom: calc(5.5% - 12px);
    display: flex;
    align-items: center;
    gap: 4px;
    transform: translateX(-50%);
  }

  .hero__dots {
    display: flex;
    gap: 4px;
  }

  /* Bare arrow, as quiet as the inactive dots; 44px hit area */
  .hero__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: rgb(255 255 255 / 0.5);
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .hero__arrow:hover {
    color: var(--white);
  }

  .hero__arrow :global(svg) {
    width: 12px;
    height: auto;
  }

  /* 44px tall hit area around a 4px bar */
  .hero__dot {
    width: 36px;
    height: 44px;
    padding: 20px 0;
    border: 0;
    background: rgb(255 255 255 / 0.5) content-box;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .hero__dot.is-active {
    background-color: var(--white);
  }

  @media (max-width: 760px) {
    .hero {
      height: 640px;
    }

    .hero__stage {
      --band-a: var(--a-mobile);
      --band-b: var(--b-mobile);
      top: calc(-1 * var(--lift));
      left: 0;
      height: auto;
      bottom: 0;
      aspect-ratio: auto;
    }

    .hero__image {
      mask-image: none;
    }

    .hero__title--main {
      max-width: 100%;
    }

    .hero__copy {
      align-items: flex-end;
      padding-bottom: 212px;
    }

    .hero__actions {
      bottom: 60px;
    }

    .hero__controls {
      bottom: 8px;
    }

    .hero__title {
      text-shadow: 0 2px 16px rgb(22 22 22 / 0.35);
    }

    .hero__tag {
      text-shadow: none;
    }
  }
</style>

---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  screen?: ImageMetadata;
  alt?: string;
  class?: string;
}

const { screen, alt = '', class: className } = Astro.props;
---

<!-- Modern phone frame drawn in CSS: thin bezel, large radius and a dynamic island -->
<div class:list={['phone', className]}>
  <div class="phone__screen">
    {screen && <Image src={screen} alt={alt} widths={[240, 480]} sizes="(max-width: 760px) 50vw, 240px" />}
  </div>
</div>

<style>
  .phone {
    position: relative;
    width: 100%;
    max-width: 260px;
    aspect-ratio: 9 / 19.5;
    padding: 3.6%;
    border-radius: 15% / 7%;
    background: var(--ink);
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.16),
      0 40px 70px -30px rgb(22 22 22 / 0.6);
  }

  /* Dynamic island */
  .phone::before {
    content: '';
    position: absolute;
    top: 5.2%;
    left: 50%;
    z-index: 1;
    width: 30%;
    height: 3.4%;
    border-radius: 999px;
    background: var(--ink);
    transform: translateX(-50%);
  }

  .phone__screen {
    height: 100%;
    overflow: hidden;
    border-radius: 12% / 5.6%;
    background: var(--surface);
  }

  .phone__screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

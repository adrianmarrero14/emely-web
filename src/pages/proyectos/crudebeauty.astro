---
import { Image } from 'astro:assets';
import CaseStudy from '../../layouts/CaseStudy.astro';
import CaseSection from '../../components/CaseSection.astro';
import ResponsiveFigure from '../../components/ResponsiveFigure.astro';
import cover from '../../assets/projects/home/crudebeauty.jpg';
import reto from '../../assets/projects/crudebeauty/reto.jpg';
import proceso from '../../assets/projects/crudebeauty/proceso.png';
import procesoMobile from '../../assets/projects/crudebeauty/proceso-mobile.png';
import competencia1 from '../../assets/projects/crudebeauty/competencia-1.png';
import competencia2 from '../../assets/projects/crudebeauty/competencia-2.png';
import competencia3 from '../../assets/projects/crudebeauty/competencia-3.png';
import competenciaMobile1 from '../../assets/projects/crudebeauty/competencia-mobile-1.png';
import competenciaMobile2 from '../../assets/projects/crudebeauty/competencia-mobile-2.png';
import competenciaMobile3 from '../../assets/projects/crudebeauty/competencia-mobile-3.png';
import persona from '../../assets/projects/crudebeauty/persona.jpg';
import solucion1 from '../../assets/projects/crudebeauty/solucion-1.png';
import solucion2 from '../../assets/projects/crudebeauty/solucion-2.png';
import branding from '../../assets/projects/crudebeauty/branding.png';
import colores from '../../assets/projects/crudebeauty/colores.jpg';
import iconos from '../../assets/projects/crudebeauty/iconos.png';

const sections = [
  { id: 'reto', title: 'El reto' },
  { id: 'proceso', title: 'Proceso de diseño' },
  { id: 'competencia', title: 'Análisis competitivo' },
  { id: 'persona', title: 'User persona' },
  { id: 'solucion', title: 'La solución' },
  { id: 'branding', title: 'Branding' },
  { id: 'prototipo', title: 'Prototipo' },
  { id: 'conclusiones', title: 'Conclusiones' },
];

const competitors = [
  { name: 'The Ordinary', desktop: competencia1, mobile: competenciaMobile1 },
  { name: 'La Roche-Posay', desktop: competencia2, mobile: competenciaMobile2 },
  { name: "Kiehl's", desktop: competencia3, mobile: competenciaMobile3 },
];

const prototypeUrl =
  'https://www.figma.com/embed?embed_host=share&url=https%3A%2F%2Fwww.figma.com%2Fproto%2FSBhNVU9kQoWQXY9dcZe9B1%2FCrudeBeauty---Ecommerce%3Fpage-id%3D417%253A615%26type%3Ddesign%26node-id%3D418-616%26viewport%3D882%252C544%252C0.5%26t%3DAGEZ8JlqnFwFLjcF-1%26scaling%3Dscale-down%26starting-point-node-id%3D418%253A616%26mode%3Ddesign';
---

<CaseStudy
  slug="crudebeauty"
  name="CrudeBeauty"
  tagline="Identidad de marca y tienda online para una firma de aceites esenciales orgánicos."
  cover={cover}
  description="CrudeBeauty ofrece 9 aceites esenciales que conservan íntegras las propiedades originales de sus ingredientes y de los componentes usados en su elaboración."
  brief="Diseñar el sitio web y la tienda online de CrudeBeauty para presentar al mercado esta nueva marca de aceites esenciales de origen orgánico."
  details={[
    { label: 'Cliente', value: 'CrudeBeauty' },
    { label: 'Rol', value: 'Diseñadora UX/UI' },
    { label: 'Ubicación', value: 'Madrid, España' },
    { label: 'Tipo', value: 'E-commerce y branding' },
  ]}
  sections={sections}
>
  <CaseSection id="reto" number={1} title="El reto">
    <p class="callout">
      Crear un diseño atractivo, juvenil y limpio con recursos limitados, a la altura de la competencia, que atrajera a
      nuevos usuarios, influencers, inversores y socios.
    </p>
    <figure>
      <Image src={reto} alt="Productos de CrudeBeauty" widths={[880, 1760]} sizes="(max-width: 1024px) 92vw, 880px" />
    </figure>
  </CaseSection>

  <CaseSection id="proceso" number={2} title="Proceso de diseño">
    <p>Seguí un proceso centrado en el usuario, de la investigación al prototipo validado.</p>
    <ResponsiveFigure desktop={proceso} mobile={procesoMobile} alt="Fases del proceso de diseño de CrudeBeauty" />
  </CaseSection>

  <CaseSection id="competencia" number={3} title="Análisis competitivo">
    <p>
      Analicé las webs de tres marcas de referencia, <strong>The Ordinary, La Roche-Posay y Kiehl's</strong>, para
      identificar qué funcionalidades espera encontrar el usuario en una tienda de cosmética.
    </p>
    {
      competitors.map((competitor) => (
        <ResponsiveFigure
          desktop={competitor.desktop}
          mobile={competitor.mobile}
          alt={`Análisis de la web de ${competitor.name} y sus funcionalidades`}
        />
      ))
    }
  </CaseSection>

  <CaseSection id="persona" number={4} title="User persona">
    <div class="persona">
      <Image src={persona} alt="María Morales, user persona del proyecto" widths={[300, 600]} sizes="(max-width: 760px) 70vw, 260px" />
      <div>
        <h4>María Morales</h4>
        <dl class="facts">
          <dt>Edad</dt><dd>28 años</dd>
          <dt>Ubicación</dt><dd>Madrid, España</dd>
          <dt>Estado civil</dt><dd>Soltera</dd>
          <dt>Estudios</dt><dd>Lengua y Literatura</dd>
          <dt>Profesión</dt><dd>Profesora de idiomas</dd>
          <dt>Ingresos</dt><dd>24.000 € brutos al año</dd>
        </dl>
        <p style="margin-top: 14px">
          Enseña inglés y francés en una escuela de idiomas. Cuida su piel con una rutina de skincare y comparte en redes
          sociales los productos que va descubriendo.
        </p>
      </div>
    </div>
    <ul class="cards">
      <li class="card">
        <h4>Motivación</h4>
        Considera el cuidado de su piel una parte importante de su salud y bienestar.
      </li>
      <li class="card">
        <h4>Necesidades</h4>
        Productos de calidad, eficaces para mantener la piel sana y seguros de usar.
      </li>
      <li class="card">
        <h4>Miedos</h4>
        Usar mal un producto y sufrir daños permanentes, como manchas o irritaciones.
      </li>
    </ul>
    <h3>¿Cómo compra María sus productos de belleza?</h3>
    <p>
      Antes de comprar, investiga: lee reseñas en línea, revisa los ingredientes y valora las necesidades de su piel.
      También sigue a bloggers y expertos para obtener recomendaciones.
    </p>
  </CaseSection>

  <CaseSection id="solucion" number={5} title="La solución">
    <ul class="cards">
      <li class="card">
        <h4>Una estética fresca y juvenil</h4>
        Creé un nuevo logotipo y diseñé envases que reflejan la identidad de la marca.
      </li>
      <li class="card">
        <h4>Una web que vende</h4>
        Banners llamativos, recomendaciones de aceites según el tipo de piel y carrito de compra.
      </li>
      <li class="card">
        <h4>Un MVP para aprender rápido</h4>
        Lanzar cuanto antes con las funciones mínimas para atraer a los primeros usuarios y validar mejoras con el menor
        esfuerzo.
      </li>
    </ul>
    <div class="gallery" style="--cols: 2">
      <Image src={solucion1} alt="Página de inicio de la web de CrudeBeauty" />
      <Image src={solucion2} alt="Ficha de producto de CrudeBeauty" />
    </div>
  </CaseSection>

  <CaseSection id="branding" number={6} title="Branding">
    <p>
      El logotipo combina dos palabras en una tipografía elegante y natural, dividida en dos líneas para lograr equilibrio
      visual y rematada con un punto final.
    </p>
    <figure class="brand-logo">
      <Image src={branding} alt="Logotipo de CrudeBeauty" />
    </figure>

    <div class="brand-specs">
      <div>
        <h3>Colores</h3>
        <ul class="swatches">
          <li>
            <span class="swatch" style="background: rgb(121 217 124)"></span>
            <span><strong>Pantone 2268 C</strong><br />C49 M0 Y65 K100 · R121 G217 B124</span>
          </li>
          <li>
            <span class="swatch" style="background: #000"></span>
            <span><strong>Pantone Neutral Black C</strong><br />C10 M0 Y0 K100 · R0 G0 B0</span>
          </li>
        </ul>
        <h3>Tipografía</h3>
        <dl class="facts">
          <dt>Títulos</dt><dd>Gotham Book</dd>
          <dt>Subtítulos</dt><dd>Gotham Book</dd>
          <dt>Párrafos</dt><dd>Gotham Book</dd>
          <dt>Precios</dt><dd>Gotham Medium</dd>
        </dl>
      </div>
      <Image src={colores} alt="Envases de CrudeBeauty con la paleta de la marca" widths={[440, 880]} sizes="(max-width: 760px) 92vw, 400px" />
    </div>

    <h3>Iconografía</h3>
    <p>Elegí un conjunto de iconos fiel a la estética de la marca para garantizar una apariencia uniforme en todo el producto.</p>
    <figure class="brand-icons">
      <Image src={iconos} alt="Conjunto de iconos de CrudeBeauty" />
    </figure>
  </CaseSection>

  <CaseSection id="prototipo" number={7} title="Prototipo">
    <p>Explora el <strong>prototipo interactivo</strong> y descubre todas las posibilidades de la interfaz.</p>
    <div class="prototype">
      <iframe src={prototypeUrl} title="Prototipo interactivo de CrudeBeauty en Figma" loading="lazy" allowfullscreen></iframe>
    </div>
  </CaseSection>

  <CaseSection id="conclusiones" number={8} title="Conclusiones">
    <p>
      Las pruebas de la solución confirmaron una estrategia sólida para dar visibilidad a CrudeBeauty. La estética fresca
      y juvenil, el nuevo logotipo y unos envases que capturan la esencia de la marca sentaron las bases de una identidad
      visual vibrante y atractiva.
    </p>
    <p>
      La web, con banners cautivadores y carrito de compra, ofrece una plataforma sólida para atraer a los primeros
      usuarios. Concebida como un MVP, reúne un conjunto básico pero eficaz de funcionalidades que permite salir al
      mercado en tiempo récord.
    </p>
    <p class="callout">
      Recoger feedback desde el inicio permitirá ajustar y ampliar las funcionalidades según las necesidades reales de los
      clientes, garantizando un crecimiento continuo y una gran experiencia de usuario.
    </p>
  </CaseSection>
</CaseStudy>

<style>
  .brand-logo,
  .brand-icons {
    display: flex;
    justify-content: center;
    padding: 32px;
    border-radius: var(--radius);
    background: var(--surface);
  }

  .brand-logo img {
    max-width: 520px;
  }

  .brand-icons img {
    max-width: 360px;
  }

  .brand-specs {
    display: grid;
    grid-template-columns: 1fr minmax(0, 380px);
    align-items: start;
    gap: 32px;
  }

  .brand-specs h3:not(:first-child) {
    margin-top: 24px;
  }

  .brand-specs > img {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .swatches {
    display: grid;
    gap: 14px;
    margin-top: 12px;
    padding: 0;
    list-style: none;
  }

  .swatches li {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 14px;
    line-height: 1.5;
  }

  .swatch {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08);
  }

  @media (max-width: 760px) {
    .brand-specs {
      grid-template-columns: 1fr;
    }
  }
</style>

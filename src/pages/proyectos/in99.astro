---
import { Image } from 'astro:assets';
import CaseStudy from '../../layouts/CaseStudy.astro';
import CaseSection from '../../components/CaseSection.astro';
import PhoneMockup from '../../components/PhoneMockup.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import cover from '../../assets/projects/home/in99.png';
import antonio from '../../assets/projects/in99/antonio.jpg';
import idea from '../../assets/projects/in99/idea.jpg';
import flujo from '../../assets/projects/in99/flujo.png';
import wireframes from '../../assets/projects/in99/wireframes.png';
import protoLogin from '../../assets/projects/in99/proto-login.png';
import protoHome from '../../assets/projects/in99/proto-home.png';
import protoGastos from '../../assets/projects/in99/proto-gastos.png';
import protoResumen from '../../assets/projects/in99/proto-resumen.png';
import h01 from '../../assets/projects/in99/heuristica-01.png';
import h02 from '../../assets/projects/in99/heuristica-02.png';
import h03 from '../../assets/projects/in99/heuristica-03.png';
import h04 from '../../assets/projects/in99/heuristica-04.png';
import h05 from '../../assets/projects/in99/heuristica-05.png';
import h06 from '../../assets/projects/in99/heuristica-06.png';
import h07 from '../../assets/projects/in99/heuristica-07.png';
import h08 from '../../assets/projects/in99/heuristica-08.png';
import h09 from '../../assets/projects/in99/heuristica-09.png';
import h10 from '../../assets/projects/in99/heuristica-10.png';

const sections = [
  { id: 'reto', title: 'El reto' },
  { id: 'proceso', title: 'Proceso de diseño' },
  { id: 'persona', title: 'User persona' },
  { id: 'empatia', title: 'Mapa de empatía' },
  { id: 'hmw-jtbd', title: 'HMW y JTBD' },
  { id: 'hipotesis', title: 'Hipótesis y experimento' },
  { id: 'solucion', title: 'La solución' },
  { id: 'flujo', title: 'Flujo de usuario' },
  { id: 'wireframes', title: 'Wireframes' },
  { id: 'prototipo', title: 'Prototipo' },
  { id: 'heuristicas', title: 'Análisis heurístico' },
  { id: 'pruebas', title: 'Próximo paso' },
];

const process = [
  { title: 'Empatizar', text: 'Investigar las necesidades financieras de los usuarios.' },
  { title: 'Definir', text: 'Fijar los objetivos de la calculadora de ahorro y las funcionalidades necesarias.' },
  { title: 'Idear', text: 'Crear el flujo de usuario y wireframes interactivos para simular la experiencia.' },
  { title: 'Prototipar', text: 'Construir una interfaz atractiva y coherente, siguiendo principios de usabilidad y diseño centrado en el usuario.' },
  { title: 'Probar', text: 'Validar que la aplicación sea intuitiva y cumpla las expectativas de los usuarios.' },
];

const empathy = [
  {
    title: '¿Qué piensa y siente?',
    hint: 'Preocupaciones y aspiraciones',
    items: ['Ahorrar para la universidad de sus hijos', 'La llegada del nuevo bebé', 'Controlar sus ingresos'],
  },
  {
    title: '¿Qué oye?',
    hint: 'Lo que dicen sus amigos y su familia',
    items: ['Su esposa, preocupada por los gastos', 'Planes de viaje con amigos', 'Su hijo mayor, emocionado por la universidad'],
  },
  {
    title: '¿Qué ve?',
    hint: 'Su entorno y lo que ofrece el mercado',
    items: ['Amigos que viajan con sus hijos', 'Su hijo mayor entra en la universidad', 'El nacimiento de su bebé', 'Planes de jubilación'],
  },
  {
    title: '¿Qué dice y hace?',
    hint: 'Actitud en público y con los demás',
    items: ['Profesional en su trabajo', 'Familiar', 'Comprometido', 'Amable con el personal de la orquesta', 'Los músicos con los que trabaja lo admiran'],
  },
];

const features = [
  {
    title: 'Calculadora de ahorro',
    text: 'Planificar el ahorro y ver cuánto se acumula según el perfil y las metas personales.',
    icon: 'M6 2h12a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2ZM8 6h8v4H8ZM8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01',
  },
  {
    title: 'Contratación de productos financieros',
    text: 'Acceder a los productos de las entidades asociadas para hacer crecer el rendimiento de las inversiones.',
    icon: 'M3 17l6-6 4 4 8-8M15 7h6v6',
  },
  {
    title: 'Invitar a amigos',
    text: 'Obtener descuentos al invitar a otras personas a unirse a la plataforma.',
    icon: 'M15 19v-1a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v1M8.5 10a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM19 8v6M22 11h-6',
  },
];

const heuristics = [
  {
    image: h01,
    title: 'Visibilidad del estado del sistema',
    text: 'El sistema debe mantener siempre informado al usuario, con una respuesta adecuada y en un tiempo razonable. Unas migas de pan o los pasos de un proceso ayudan a saber dónde se está en cada momento.',
    alt: 'Registro por pasos con barra de progreso, validación de campos y aviso de error de conexión',
  },
  {
    image: h02,
    title: 'Coincidencia entre el sistema y el mundo real',
    text: 'Hablar el mismo idioma que los usuarios, con palabras y conceptos que les resulten familiares, y ordenar la información de forma natural y lógica.',
    alt: 'Pantallas de gastos deducibles explicados con ejemplos cotidianos',
  },
  {
    image: h03,
    title: 'Control y libertad del usuario',
    text: 'Ofrecer siempre una forma de volver, eliminar, deshacer o editar.',
    alt: 'Pantallas de gastos con botón para volver y opción de añadir o guardar',
  },
  {
    image: h04,
    title: 'Consistencia y estándares',
    text: 'Los usuarios no deberían preguntarse si palabras, situaciones o acciones distintas significan lo mismo. Si un botón de acción es verde, debe verse igual en todas las pantallas.',
    alt: 'Flujo del plan de ahorro con el mismo botón principal en todas las pantallas',
  },
  {
    image: h05,
    title: 'Prevención de errores',
    text: 'Antes de diseñar buenos mensajes de error, hay que intentar evitarlos. En los formularios, explicar bien los requisitos de cada campo.',
    alt: 'Formulario con los requisitos de cada campo indicados de antemano',
  },
  {
    image: h06,
    title: 'Reconocer mejor que recordar',
    text: 'Evitar que el usuario tenga que memorizar objetos, acciones u opciones: deben estar visibles para no tener que recordar información de un paso a otro.',
    alt: 'Resumen de ahorro con la información del paso anterior siempre visible',
  },
  {
    image: h07,
    title: 'Flexibilidad y eficiencia de uso',
    text: 'Los atajos, invisibles para quien empieza, aceleran la interacción de los usuarios expertos. Así el sistema sirve a ambos.',
    alt: 'Pantalla de ahorro con accesos rápidos',
  },
  {
    image: h08,
    title: 'Diseño estético y minimalista',
    text: 'Menos es más: cada dato extra compite con la información importante y le resta jerarquía.',
    alt: 'Pantallas limpias con la información esencial',
  },
  {
    image: h09,
    title: 'Reconocer, diagnosticar y recuperarse de errores',
    text: 'Un lenguaje común y llano ayuda a identificar el problema y sugiere una solución.',
    alt: 'Mensajes de error claros con la solución propuesta',
  },
  {
    image: h10,
    title: 'Ayuda y documentación',
    text: 'Lo ideal es que la app se use sin documentación. Aun así, un buen buscador, un asistente o unas buenas preguntas frecuentes ayudan en caso de duda.',
    alt: 'Pantallas de ayuda con buscador, información y preguntas frecuentes',
  },
];

// Static exports from the Figma file fill the layout on every device; the live file opens in a new tab.
const wireframesLink = 'https://www.figma.com/design/1dLWx1SeuifhFIy1qPpWbL/In99?node-id=429-3313';
const prototypeLink =
  'https://www.figma.com/proto/1dLWx1SeuifhFIy1qPpWbL/In99?page-id=9%3A2&node-id=54-4388&starting-point-node-id=53%3A2854&scaling=scale-down';

const screens = [
  { image: protoLogin, alt: 'Inicio de sesión con correo, contraseña y huella' },
  { image: protoHome, alt: 'Inicio con ingresos, gastos, impuestos y previsión del mes' },
  { image: protoGastos, alt: 'Registro de un gasto deducible con su explicación fiscal' },
  { image: protoResumen, alt: 'Resumen mensual del ahorro por categorías' },
];

const challenge = [
  { title: 'Complejidad financiera', text: 'Ingresos, gastos deducibles, impuestos y productos de ahorro en una sola herramienta.' },
  { title: 'Usabilidad', text: 'Una interfaz clara y flexible para personas que no son expertas en finanzas.' },
  { title: 'Normativa y privacidad', text: 'Cumplir la regulación financiera y proteger los datos personales.' },
];
---

<CaseStudy
  slug="in99"
  name="in99"
  tagline="Una calculadora de ahorro móvil para una startup de servicios profesionales."
  cover={cover}
  description="in99 ofrece servicios profesionales exclusivamente online. Gracias a una nueva alianza con entidades financieras, quiere acercar a sus clientes los productos de esas instituciones."
  brief="Diseñar una app móvil que funcione como calculadora de ahorro: que permita calcular y planificar los ahorros en función de distintas variables financieras."
  details={[
    { label: 'Cliente', value: 'in99' },
    { label: 'Rol', value: 'Diseñadora UX/UI' },
    { label: 'Ubicación', value: 'Madrid, España' },
    { label: 'Tipo', value: 'App móvil fintech' },
  ]}
  sections={sections}
>
  <CaseSection id="reto" number={1} title="El reto">
    <p class="callout">
      Equilibrar la complejidad financiera con la usabilidad: una herramienta flexible, clara y accesible que, además,
      cumpla la normativa financiera y proteja la privacidad de los datos personales.
    </p>
    <ul class="cards">
      {
        challenge.map((item) => (
          <li class="card">
            <h4>{item.title}</h4>
            {item.text}
          </li>
        ))
      }
    </ul>
  </CaseSection>

  <CaseSection id="proceso" number={2} title="Proceso de diseño">
    <p>Seguí un proceso de Design Thinking en cinco fases, de la investigación a la validación.</p>
    <ol class="steps">
      {
        process.map((step, index) => (
          <li>
            <span class="steps__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h4>{step.title}</h4>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </CaseSection>

  <CaseSection id="persona" number={3} title="User persona">
    <div class="persona">
      <figure class="persona-photo">
        <Image src={antonio} alt="Antonio Valdés, user persona del proyecto" widths={[300, 542]} sizes="(max-width: 760px) 70vw, 260px" />
        <figcaption>“El ahorro para la educación de mis hijos es mi prioridad”.</figcaption>
      </figure>
      <div>
        <h4>Antonio Valdés</h4>
        <dl class="facts">
          <dt>Edad</dt><dd>44 años</dd>
          <dt>Ubicación</dt><dd>Madrid, España</dd>
          <dt>Ocupación</dt><dd>Director de orquesta, autónomo</dd>
          <dt>Familia</dt><dd>Casado, con 2 hijos y 1 en camino</dd>
        </dl>
        <p style="margin-top: 14px">
          Trabaja bajo el Régimen Especial de Trabajadores Autónomos. Con el tercer bebé en camino pasarán a ser familia
          numerosa, y su principal preocupación es ahorrar para la educación de sus hijos. Le gustan la música clásica y la
          danza contemporánea.
        </p>
      </div>
    </div>
    <ul class="cards">
      <li class="card">
        <h4>Necesidades</h4>
        Ahorrar dinero, equilibrar gastos y ahorro sin renunciar al estilo de vida de su familia y mejorar su situación
        económica.
      </li>
      <li class="card">
        <h4>Puntos de dolor</h4>
        Necesita una solución flexible y sin burocracia que le ayude, de forma práctica, a ahorrar y mantener el estilo de
        vida familiar.
      </li>
      <li class="card">
        <h4>Perfil digital</h4>
        Se maneja con soltura en internet, redes sociales, compras online y aplicaciones móviles.
      </li>
    </ul>
  </CaseSection>

  <CaseSection id="empatia" number={4} title="Mapa de empatía">
    <div class="empathy">
      {
        empathy.map((quadrant) => (
          <div class="empathy__quadrant">
            <h4>{quadrant.title}</h4>
            <p class="empathy__hint">{quadrant.hint}</p>
            <ul>
              {quadrant.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))
      }
      <Image class="empathy__photo" src={antonio} alt="" widths={[200, 400]} sizes="160px" />
    </div>
    <div class="pains-gains">
      <div class="pains-gains__col">
        <h4>Dolores</h4>
        <p class="empathy__hint">Miedos, frustraciones y obstáculos</p>
        <ul>
          <li>Su situación económica con 3 hijos</li>
          <li>Todo lo que paga en la declaración de la renta</li>
          <li>Que se complique el parto</li>
        </ul>
      </div>
      <div class="pains-gains__col pains-gains__col--gains">
        <h4>Ganancias</h4>
        <p class="empathy__hint">Deseos, necesidades y logros</p>
        <ul>
          <li>Mantener su calidad de vida y la de su familia</li>
          <li>El bebé en camino</li>
          <li>El premio de la orquesta</li>
        </ul>
      </div>
    </div>
  </CaseSection>

  <CaseSection id="hmw-jtbd" number={5} title="How Might We y Jobs To Be Done">
    <p>
      Las preguntas <strong>How Might We (HMW)</strong> convierten los retos difíciles en oportunidades creativas. La teoría
      de <strong>Jobs To Be Done (JTBD)</strong> sostiene que las personas no compran productos: buscan soluciones a los
      problemas de su vida.
    </p>
    <div class="voice brand-surface">
      <div class="brand-surface__tint" aria-hidden="true"></div>
      <Image class="voice__image" src={idea} alt="" widths={[300, 600]} sizes="(max-width: 760px) 40vw, 220px" />
      <blockquote class="glass voice__quote">
        <p>
          “Cuando haga la declaración de la renta este año quiero pagar menos y ahorrar para la universidad de mis hijos,
          tener dinero para lo que necesite el bebé que viene y planificar las vacaciones de verano”.
        </p>
        <cite>Antonio Valdés</cite>
      </blockquote>
    </div>
    <h3>How Might We…</h3>
    <ul class="cards cards--2">
      <li class="card"><h4>HMW</h4>¿Cómo podemos ayudar a Antonio a pagar menos en su declaración de la renta?</li>
      <li class="card"><h4>HMW</h4>¿Cómo podemos ayudar a Antonio a controlar los gastos del nuevo bebé?</li>
      <li class="card"><h4>HMW</h4>¿Cómo podemos ayudar a Antonio a ahorrar para la universidad de sus hijos?</li>
      <li class="card"><h4>HMW</h4>¿Cómo podemos ayudar a Antonio a planificar los gastos de sus vacaciones de verano?</li>
    </ul>
    <h3>Jobs To Be Done</h3>
    <ul class="cards">
      <li class="card">
        <h4>JTBD</h4>
        Si Antonio paga menos en la declaración de la renta, tendrá más dinero disponible para sus planes de ahorro.
      </li>
      <li class="card">
        <h4>JTBD</h4>
        Si Antonio controla los gastos del bebé que está por nacer, podrá planificar sin problemas las vacaciones de
        verano.
      </li>
    </ul>
  </CaseSection>

  <CaseSection id="hipotesis" number={6} title="Hipótesis y experimento">
    <h3>Hipótesis</h3>
    <p class="callout">
      Usuarios como Antonio, de familias numerosas y con dificultades económicas, buscan estrategias para pagar menos
      impuestos, ahorrar para necesidades futuras y mantener su nivel de vida y el de su familia.
    </p>
    <h3>Experimento</h3>
    <p>
      El experimento se centra en <strong>optimizar el cálculo de gastos deducibles</strong> para maximizar el ahorro en su
      actividad económica:
    </p>
    <ul class="list">
      <li>Una consulta de gastos para registrar y categorizar los gastos asociados a la llegada del bebé.</li>
      <li>Conexión con sus bancos para un registro detallado.</li>
      <li>Una calculadora de gastos deducibles que muestra el ahorro acumulado, con acceso a los detalles fiscales y a la estimación de pagos futuros.</li>
      <li>Asesoría fiscal, modelos de declaración y soporte para resolver consultas con Hacienda.</li>
      <li>Descuentos por invitar a amigos a unirse a la plataforma.</li>
    </ul>
  </CaseSection>

  <CaseSection id="solucion" number={7} title="La solución">
    <p>
      Una <strong>calculadora de ahorro</strong> que ayuda a planificar y gestionar productos financieros para maximizar el
      rendimiento de las inversiones, adaptada al perfil y las metas de cada persona. Sus funciones clave:
    </p>
    <ul class="features">
      {
        features.map((feature) => (
          <li>
            <span class="features__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d={feature.icon} />
              </svg>
            </span>
            <h4>{feature.title}</h4>
            <p>{feature.text}</p>
          </li>
        ))
      }
    </ul>
  </CaseSection>

  <CaseSection id="flujo" number={8} title="Flujo de usuario">
    <p>Estos son los pasos que sigue el usuario al usar la calculadora.</p>
    <figure class="zoomable">
      <Image src={flujo} alt="Diagrama del flujo de usuario de la calculadora de ahorro" widths={[880, flujo.width]} sizes="(max-width: 1024px) 92vw, 880px" />
      <figcaption>
        <a class="link-arrow" href={flujo.src} target="_blank" rel="noopener noreferrer">
          Ver el diagrama a tamaño completo
          <span class="visually-hidden">(se abre en una pestaña nueva)</span>
        </a>
      </figcaption>
    </figure>
  </CaseSection>

  <CaseSection id="wireframes" number={9} title="Wireframes">
    <p>
      Los wireframes de baja fidelidad representan la estructura básica de la interfaz: se centran en la disposición de
      los elementos, la funcionalidad y la organización del contenido, sin detalles visuales.
    </p>
    <figure class="wireframes">
      <Image src={wireframes} alt="Mapa de wireframes de in99: registro, inicio, ingresos, gastos, productos, invitar amigos y perfil" widths={[880, wireframes.width]} sizes="(max-width: 1024px) 92vw, 880px" />
    </figure>
    <div class="actions">
      <a class="btn btn--ghost" href={wireframesLink} target="_blank" rel="noopener noreferrer">
        Ver los wireframes en Figma <ArrowIcon />
        <span class="visually-hidden">(se abre en una pestaña nueva)</span>
      </a>
    </div>
  </CaseSection>

  <CaseSection id="prototipo" number={10} title="Prototipo en alta fidelidad">
    <p>
      El <strong>prototipo interactivo</strong> recorre el inicio de sesión y el camino feliz, la contratación de un plan de
      ahorro y la conexión con el banco.
    </p>
    <div class="showcase brand-surface">
      <div class="brand-surface__tint" aria-hidden="true"></div>
      <ul class="showcase__screens">
        {
          screens.map((screen) => (
            <li>
              <PhoneMockup screen={screen.image} alt={screen.alt} />
            </li>
          ))
        }
      </ul>
      <div class="glass showcase__cta">
        <p>Pruébalo tú: navega por las pantallas como lo haría Antonio.</p>
        <a class="btn btn--light" href={prototypeLink} target="_blank" rel="noopener noreferrer">
          Abrir el prototipo en Figma <ArrowIcon />
          <span class="visually-hidden">(se abre en una pestaña nueva)</span>
        </a>
      </div>
    </div>
  </CaseSection>

  <CaseSection id="heuristicas" number={11} title="Análisis heurístico">
    <p>
      Para definir la UX evalué la interfaz con las <strong>10 heurísticas de usabilidad de Jakob Nielsen</strong>, pautas
      que ayudan a detectar problemas potenciales y mejorar la experiencia. Así se aplica cada una en in99:
    </p>
    <div class="heuristics" data-heuristics>
      <ol class="heuristics__track" data-track>
        {
          heuristics.map((heuristic, index) => (
            <li class="heuristics__slide" aria-label={`${index + 1} de ${heuristics.length}`}>
              <div class="heuristics__media">
                <Image src={heuristic.image} alt={heuristic.alt} widths={[700, heuristic.image.width]} sizes="(max-width: 760px) 90vw, 700px" />
              </div>
              <div class="heuristics__copy">
                <span class="heuristics__number">{String(index + 1).padStart(2, '0')}</span>
                <h4>{heuristic.title}</h4>
                <p>{heuristic.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="heuristics__controls">
        <button type="button" class="heuristics__button" data-prev aria-label="Heurística anterior">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <p class="heuristics__count" aria-live="polite"><span data-current>1</span> / {heuristics.length}</p>
        <button type="button" class="heuristics__button" data-next aria-label="Heurística siguiente">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </button>
      </div>
    </div>
  </CaseSection>

  <CaseSection id="pruebas" number={12} title="Próximo paso: probar con usuarios">
    <p>
      Con la solución definida, toca validarla sin olvidar que <strong>no somos el usuario final</strong>. Estos son los
      métodos propuestos:
    </p>
    <ul class="cards">
      <li class="card">
        <h4>Test de percepción</h4>
        Mostrar una pantalla durante 2 a 5 segundos y preguntar después qué se ha entendido de ella.
      </li>
      <li class="card">
        <h4>Mapas de calor y grabaciones</h4>
        Observar cómo se desplazan los usuarios y qué zonas captan su atención mientras usan la app.
      </li>
      <li class="card">
        <h4>Test con usuarios</h4>
        Probar con personas reales para alinear el diseño con sus expectativas y corregir errores antes del lanzamiento.
      </li>
    </ul>
  </CaseSection>
</CaseStudy>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-heuristics]')) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...track.children] as HTMLElement[];
    const current = root.querySelector('[data-current]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    let index = 0;

    const update = () => {
      current.textContent = String(index + 1);
      prev.disabled = index === 0;
      next.disabled = index === slides.length - 1;
    };

    const go = (to: number) => {
      index = Math.max(0, Math.min(slides.length - 1, to));
      track.scrollTo({ left: slides[index].offsetLeft - track.offsetLeft, behavior: 'smooth' });
      update();
    };

    prev.addEventListener('click', () => go(index - 1));
    next.addEventListener('click', () => go(index + 1));

    // Keep the counter in sync when the user swipes; wait until scrolling settles
    // so a smooth scroll triggered by the buttons doesn't reset the index midway.
    let settle: number | undefined;
    track.addEventListener('scroll', () => {
      clearTimeout(settle);
      settle = window.setTimeout(() => {
        const nearest = Math.round(track.scrollLeft / track.clientWidth);
        if (nearest !== index) {
          index = nearest;
          update();
        }
      }, 150);
    }, { passive: true });

    update();
  }
</script>


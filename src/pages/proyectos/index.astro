---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PhoneMockup from '../../components/PhoneMockup.astro';
import CtaBar from '../../components/CtaBar.astro';
import portfolioHero from '../../assets/figma/portfolio-hero.png';
import portfolioDesk from '../../assets/figma/portfolio-desk.png';
import { projects, upcomingProjects } from '../../data/site';

const published = projects.filter((project) => project.href);
const inProgress = projects.length - published.length + upcomingProjects.length;
---

<Base title="Proyectos" description="Casos de estudio de Emely Aponte: sistema de diseño para PinsXP, banca móvil para Mercantil Banco, e-commerce para CrudeBeauty y una app fintech para in99.">
  <section class="intro brand-surface" aria-labelledby="intro-title">
    <Image class="brand-surface__photo intro__image" src={portfolioHero} alt="" widths={[640, 1280, portfolioHero.width]} sizes="100vw" loading="eager" />
    <div class="brand-surface__tint" aria-hidden="true"></div>
    <div class="intro__shape intro__shape--fuchsia" aria-hidden="true"></div>
    <div class="intro__shape intro__shape--purple" aria-hidden="true"></div>
    <div class="container intro__inner">
      <div class="glass intro__panel">
        <p class="eyebrow">Proyectos</p>
        <h1 id="intro-title" class="title-xl">Una muestra de <span class="highlight">mi trabajo</span></h1>
        <p class="intro__lead">
          Cada caso de estudio recorre el proceso completo: contexto, investigación, decisiones de diseño y resultados.
        </p>
        <dl class="intro__facts">
          <div>
            <dt>Casos de estudio</dt>
            <dd>{published.length}</dd>
          </div>
          <div>
            <dt>En preparación</dt>
            <dd>{inProgress}</dd>
          </div>
          <div class="intro__facts-sectors">
            <dt>Sectores</dt>
            <dd>Fintech · Social · E-commerce</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="cases" aria-labelledby="cases-title">
    <div class="container">
      <h2 id="cases-title" class="visually-hidden">Casos de estudio</h2>
      <ul class="cases__grid">
        {
          projects.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="quote-band brand-surface" aria-label="Cita">
    <Image class="brand-surface__photo quote-band__image" src={portfolioDesk} alt="" widths={[700, 1000, 1400]} sizes="100vw" />
    <div class="brand-surface__tint quote-band__tint" aria-hidden="true"></div>
    <div class="container quote-band__inner">
      <blockquote class="glass quote quote-band__quote">
        <p>“El diseño digital es como una pintura al óleo, excepto que la pintura nunca se seca”.</p>
        <cite>Neville Brody</cite>
      </blockquote>
    </div>
  </section>

  <section class="upcoming" aria-labelledby="upcoming-title">
    <div class="container upcoming__head">
      <p class="eyebrow">Próximamente</p>
      <h2 id="upcoming-title" class="title-lg">En <span class="highlight highlight--soft">construcción</span></h2>
      <p class="lead">Pronto podrás ver estos casos de estudio completos.</p>
    </div>
    <div class="container">
      <ul class="upcoming__grid">
        {
          upcomingProjects.map((project) => (
            <li class="upcoming__tile brand-surface">
              <div class="brand-surface__tint" aria-hidden="true"></div>
              <PhoneMockup screen={project.portrait} alt="" class="upcoming__phone" />
              <div class="glass upcoming__label">
                <h3>{project.name}</h3>
                <p>{project.category}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBar showProjects={false} />
</Base>

<style>
  /* Cabecera: foto en duotono de marca con un panel de cristal */
  .intro {
    display: flex;
    align-items: center;
    min-height: clamp(520px, 44vw, 640px);
  }

  .intro :global(.intro__image) {
    object-position: 60% center;
  }

  .intro__shape {
    position: absolute;
    border-radius: 24px;
  }

  .intro__shape--fuchsia {
    top: 14%;
    right: 6%;
    width: clamp(120px, 16vw, 230px);
    aspect-ratio: 1;
    background: var(--fuchsia);
    box-shadow: 0 30px 60px -20px rgb(22 22 22 / 0.45);
    transform: rotate(8deg);
  }

  .intro__shape--purple {
    right: 18%;
    bottom: 12%;
    width: clamp(90px, 11vw, 160px);
    aspect-ratio: 1;
    border: 1px solid var(--glass-line);
    background: rgb(102 0 191 / 0.55);
    backdrop-filter: blur(10px);
    transform: rotate(-6deg);
  }

  .intro__inner {
    position: relative;
    padding-block: clamp(48px, 7vw, 96px);
  }

  .intro__panel {
    display: grid;
    justify-items: start;
    gap: 20px;
    max-width: 600px;
    padding: clamp(28px, 4vw, 48px);
  }

  .intro__lead {
    max-width: 460px;
    font-size: clamp(17px, 1.4vw, 19px);
    font-weight: var(--fw-light);
    line-height: 1.7;
  }

  .intro__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 36px;
    width: 100%;
    margin-top: 8px;
    padding-top: 22px;
    border-top: 1px solid var(--glass-line);
  }

  .intro__facts div {
    display: flex;
    flex-direction: column-reverse;
  }

  .intro__facts dt {
    font-size: 13px;
    font-weight: var(--fw-light);
    opacity: 0.85;
  }

  .intro__facts dd {
    font-size: 30px;
    font-weight: var(--fw-bold);
    line-height: 1.2;
  }

  .intro__facts .intro__facts-sectors dd {
    padding-top: 10px;
    font-size: 16px;
    font-weight: var(--fw-semibold);
  }

  /* Casos de estudio */
  .cases {
    padding-block: clamp(56px, 7vw, 96px);
    background: var(--purple-06);
  }

  .cases__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
    padding: 0;
    list-style: none;
  }

  /* Cita */
  .quote-band :global(.quote-band__image) {
    transform: scaleY(-1);
  }

  /* The tint mirrors the banner: fuchsia ends under the quote on the right */
  .quote-band__tint {
    transform: scaleX(-1);
  }

  .quote-band__inner {
    position: relative;
    display: flex;
    justify-content: flex-end;
    padding-block: clamp(64px, 10vw, 136px);
  }

  .quote-band__quote {
    max-width: 480px;
    padding: clamp(24px, 3vw, 40px);
  }

  /* Próximamente */
  .upcoming {
    padding-block: clamp(56px, 7vw, 96px);
  }

  .upcoming__head {
    display: grid;
    justify-items: start;
    gap: 12px;
    margin-bottom: 40px;
  }

  .upcoming__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(20px, 3vw, 40px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .upcoming__tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 48px 24px 32px;
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .upcoming__tile:nth-child(even) .brand-surface__tint {
    transform: scaleX(-1);
  }

  .upcoming__tile :global(.upcoming__phone) {
    position: relative;
    width: min(60%, 220px);
  }

  .upcoming__label {
    position: relative;
    width: 100%;
    max-width: 320px;
    padding: 16px 20px;
    border-radius: var(--radius-md);
  }

  .upcoming__label h3 {
    font-size: 22px;
    font-weight: var(--fw-semibold);
  }

  .upcoming__label p {
    font-size: 14px;
    font-weight: var(--fw-light);
  }

  @media (max-width: 1024px) {
    .intro__shape--purple {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .intro {
      align-items: flex-end;
      min-height: 0;
    }

    .intro__inner {
      padding-top: 140px;
    }

    .intro__shape--fuchsia {
      top: 32px;
      right: var(--gutter);
      width: 96px;
    }

    .quote-band__inner {
      justify-content: stretch;
    }

    .cases__grid,
    .upcoming__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

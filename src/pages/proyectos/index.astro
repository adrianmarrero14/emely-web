---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PhoneMockup from '../../components/PhoneMockup.astro';
import CtaBar from '../../components/CtaBar.astro';
import portfolioHero from '../../assets/figma/portfolio-hero.png';
import portfolioDesk from '../../assets/figma/portfolio-desk.png';
import { projects, upcomingProjects } from '../../data/site';

const published = projects.filter((project) => project.href);
const inProgress = projects.length - published.length + upcomingProjects.length;
---

<Base title="Proyectos" description="Casos de estudio de Emely Aponte: sistema de diseño para PinsXP, banca móvil para Mercantil Banco, e-commerce para CrudeBeauty y una app fintech para in99.">
  <section class="intro" aria-labelledby="intro-title">
    <Image class="intro__image" src={portfolioHero} alt="" widths={[640, 1280, portfolioHero.width]} sizes="100vw" loading="eager" />
    <div class="intro__tint" aria-hidden="true"></div>
    <div class="intro__shape intro__shape--fuchsia" aria-hidden="true"></div>
    <div class="intro__shape intro__shape--purple" aria-hidden="true"></div>
    <div class="container intro__inner">
      <div class="intro__panel">
        <p class="eyebrow intro__eyebrow">Proyectos</p>
        <h1 id="intro-title" class="title-xl intro__title">Una muestra de <span class="intro__highlight">mi trabajo</span></h1>
        <p class="intro__lead">
          Cada caso de estudio recorre el proceso completo: contexto, investigación, decisiones de diseño y resultados.
        </p>
        <dl class="intro__facts">
          <div>
            <dt>Casos de estudio</dt>
            <dd>{published.length}</dd>
          </div>
          <div>
            <dt>En preparación</dt>
            <dd>{inProgress}</dd>
          </div>
          <div class="intro__facts-sectors">
            <dt>Sectores</dt>
            <dd>Fintech · Social · E-commerce</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="cases" aria-labelledby="cases-title">
    <div class="container">
      <h2 id="cases-title" class="visually-hidden">Casos de estudio</h2>
      <ul class="cases__grid">
        {
          projects.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="quote-band" aria-label="Cita">
    <Image class="quote-band__image" src={portfolioDesk} alt="" widths={[700, 1000, 1400]} sizes="100vw" />
    <div class="quote-band__tint" aria-hidden="true"></div>
    <div class="container quote-band__inner">
      <blockquote class="quote">
        <p>“El diseño digital es como una pintura al óleo, excepto que la pintura nunca se seca”.</p>
        <cite>Neville Brody</cite>
      </blockquote>
    </div>
  </section>

  <section class="upcoming" aria-labelledby="upcoming-title">
    <div class="container upcoming__head">
      <p class="eyebrow">Próximamente</p>
      <h2 id="upcoming-title" class="title-lg">En construcción</h2>
      <p class="lead">Pronto podrás ver estos casos de estudio completos.</p>
    </div>
    <div class="container">
      <ul class="upcoming__grid">
        {
          upcomingProjects.map((project) => (
            <li class="upcoming__tile">
              <PhoneMockup screen={project.portrait} alt="" class="upcoming__phone" />
              <h3>{project.name}</h3>
              <p>{project.category}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBar showProjects={false} />
</Base>

<style>
  /* Cabecera: foto en duotono de marca con un panel de cristal y texto blanco */
  .intro {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(520px, 44vw, 640px);
    overflow: hidden;
    background: var(--purple);
    color: var(--white);
  }

  .intro__image,
  .intro__tint {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .intro__image {
    object-fit: cover;
    object-position: 60% center;
    filter: grayscale(1) contrast(1.1);
    mix-blend-mode: multiply;
  }

  /* Purple where the text sits, opening to fuchsia on the right */
  .intro__tint {
    background: linear-gradient(
      100deg,
      rgb(102 0 191 / 0.94) 0%,
      rgb(102 0 191 / 0.6) 42%,
      rgb(201 0 157 / 0.45) 100%
    );
  }

  .intro__shape {
    position: absolute;
    border-radius: 24px;
  }

  .intro__shape--fuchsia {
    top: 14%;
    right: 6%;
    width: clamp(120px, 16vw, 230px);
    aspect-ratio: 1;
    background: var(--fuchsia);
    box-shadow: 0 30px 60px -20px rgb(22 22 22 / 0.45);
    transform: rotate(8deg);
  }

  .intro__shape--purple {
    right: 18%;
    bottom: 12%;
    width: clamp(90px, 11vw, 160px);
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.3);
    background: rgb(102 0 191 / 0.55);
    backdrop-filter: blur(10px);
    transform: rotate(-6deg);
  }

  .intro__inner {
    position: relative;
    padding-block: clamp(48px, 7vw, 96px);
  }

  .intro__panel {
    display: grid;
    justify-items: start;
    gap: 20px;
    max-width: 600px;
    padding: clamp(28px, 4vw, 48px);
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 20px;
    background: rgb(255 255 255 / 0.08);
    box-shadow: 0 40px 80px -40px rgb(22 22 22 / 0.6);
    backdrop-filter: blur(18px);
  }

  .intro__eyebrow,
  .intro__title {
    color: var(--white);
  }

  /* Fuchsia marker under the key words */
  .intro__highlight {
    background: linear-gradient(transparent 68%, var(--fuchsia) 68% 90%, transparent 90%);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .intro__lead {
    max-width: 460px;
    font-size: clamp(17px, 1.4vw, 19px);
    font-weight: var(--fw-light);
    line-height: 1.7;
  }

  .intro__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 36px;
    width: 100%;
    margin-top: 8px;
    padding-top: 22px;
    border-top: 1px solid rgb(255 255 255 / 0.22);
  }

  .intro__facts div {
    display: flex;
    flex-direction: column-reverse;
  }

  .intro__facts dt {
    font-size: 13px;
    font-weight: var(--fw-light);
    opacity: 0.85;
  }

  .intro__facts dd {
    font-size: 30px;
    font-weight: var(--fw-bold);
    line-height: 1.2;
  }

  .intro__facts .intro__facts-sectors dd {
    padding-top: 10px;
    font-size: 16px;
    font-weight: var(--fw-semibold);
  }

  /* Casos de estudio */
  .cases {
    padding-block: clamp(56px, 7vw, 96px);
    background: var(--purple-06);
  }

  .cases__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
    padding: 0;
    list-style: none;
  }

  /* Cita */
  .quote-band {
    position: relative;
    overflow: hidden;
  }

  .quote-band__image,
  .quote-band__tint {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .quote-band__image {
    object-fit: cover;
    transform: scaleY(-1);
  }

  .quote-band__tint {
    background: var(--purple);
    mix-blend-mode: multiply;
  }

  .quote-band__inner {
    position: relative;
    display: flex;
    justify-content: flex-end;
    padding-block: clamp(80px, 12vw, 160px);
  }

  .quote-band blockquote {
    max-width: 440px;
  }

  /* Próximamente */
  .upcoming {
    padding-block: clamp(56px, 7vw, 96px);
  }

  .upcoming__head {
    display: grid;
    justify-items: start;
    gap: 12px;
    margin-bottom: 40px;
  }

  .upcoming__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(20px, 3vw, 40px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .upcoming__tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 48px 24px 56px;
    border-radius: var(--radius);
    background: var(--fuchsia);
    color: var(--white);
    text-align: center;
  }

  .upcoming__tile:nth-child(even) {
    background: var(--purple);
  }

  .upcoming__tile :global(.upcoming__phone) {
    width: min(60%, 220px);
    margin-bottom: 20px;
  }

  .upcoming__tile h3 {
    margin-top: 8px;
    color: var(--white);
    font-size: 24px;
    font-weight: var(--fw-semibold);
  }

  .upcoming__tile p {
    font-weight: var(--fw-light);
  }

  @media (max-width: 1024px) {
    .intro__shape--purple {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .intro {
      align-items: flex-end;
      min-height: 0;
    }

    .intro__inner {
      padding-top: 140px;
    }

    .intro__shape--fuchsia {
      top: 32px;
      right: var(--gutter);
      width: 96px;
    }

    .cases__grid,
    .upcoming__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

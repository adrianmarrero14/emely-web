---
import Base from '../layouts/Base.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
---

<Base title="Página no encontrada">
  <section class="container not-found">
    <p class="not-found__code" aria-hidden="true">404</p>
    <h1 class="title-lg">No encuentro esta página</h1>
    <p class="lead">Puede que el enlace haya cambiado o que la dirección tenga un error. Prueba desde aquí:</p>
    <div class="not-found__actions">
      <a class="btn" href="/proyectos">Ver proyectos <ArrowIcon /></a>
      <a class="btn btn--ghost" href="/">Ir al inicio</a>
    </div>
  </section>
</Base>

<style>
  .not-found {
    display: grid;
    justify-items: start;
    gap: 16px;
    padding-block: clamp(80px, 12vw, 160px);
  }

  .not-found__code {
    color: var(--fuchsia);
    font-size: clamp(64px, 10vw, 120px);
    font-weight: var(--fw-bold);
    line-height: 1;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }
</style>

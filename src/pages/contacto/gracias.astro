---
import Base from '../../layouts/Base.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
---

<Base title="Mensaje enviado" description="Gracias por escribir a Emely Aponte.">
  <section class="container thanks">
    <p class="eyebrow">Mensaje enviado</p>
    <h1 class="title-xl">¡Gracias por escribirme!</h1>
    <p class="lead">Tu mensaje ya está en camino. Te responderé lo antes posible.</p>
    <div class="thanks__actions">
      <a class="btn" href="/proyectos">Mientras tanto, mira mis proyectos <ArrowIcon /></a>
      <a class="btn btn--ghost" href="/">Volver al inicio</a>
    </div>
  </section>
</Base>

<style>
  .thanks {
    display: grid;
    justify-items: start;
    gap: 18px;
    padding-block: clamp(80px, 12vw, 160px);
  }

  .thanks__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }
</style>

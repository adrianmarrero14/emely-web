---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactBlock from '../components/ContactBlock.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import emelyCircle from '../assets/figma/emely-circle.png';
import projectsBanner from '../assets/figma/projects-banner.png';
import { projects, site } from '../data/site';
---

<Base headerVariant="overlay">
  <HeroCarousel />

  <section class="intro container" aria-labelledby="intro-title">
    <div class="intro__copy">
      <p class="eyebrow">Sobre mí</p>
      <h2 id="intro-title" class="title-lg">Producto, estrategia y <span class="text-purple highlight highlight--soft">sistemas de diseño</span></h2>
      <p class="lead">
        Soy Senior Product & UX/UI Designer. Lidero productos de principio a fin, de la investigación al handoff, y uno
        mi base en diseño gráfico con la estrategia de producto para crear interfaces claras, accesibles y escalables.
      </p>
      <dl class="panel intro__facts">
        <div>
          <dt>Años en UX/UI</dt>
          <dd>8</dd>
        </div>
        <div>
          <dt>Años en diseño gráfico</dt>
          <dd>10</dd>
        </div>
        <div>
          <dt>Base</dt>
          <dd>Madrid</dd>
        </div>
      </dl>
      <div class="actions intro__actions">
        <a class="btn" href={site.cvHome} target="_blank" rel="noopener noreferrer">
          Ver mi currículum <ArrowIcon />
          <span class="visually-hidden">(se abre en una pestaña nueva)</span>
        </a>
        <a class="btn btn--ghost" href="/sobre-mi">Conocer mi historia</a>
      </div>
    </div>
    <Image
      class="intro__photo"
      src={emelyCircle}
      alt="Retrato de Emely Aponte"
      widths={[336, 672]}
      sizes="(max-width: 760px) 70vw, 400px"
    />
  </section>

  <section class="projects-banner" aria-labelledby="projects-title">
    <div class="projects-banner__label">
      <p class="eyebrow">Proyectos</p>
      <h2 id="projects-title" class="title-lg">Casos de estudio</h2>
      <p>Del problema a la solución: investigación, decisiones de diseño y resultados.</p>
    </div>
    <div class="projects-banner__media">
      <Image
        class="projects-banner__image"
        src={projectsBanner}
        alt=""
        widths={[640, projectsBanner.width]}
        sizes="(max-width: 760px) 100vw, 70vw"
      />
      <div class="projects-banner__tint" aria-hidden="true"></div>
    </div>
    <blockquote class="glass quote projects-banner__quote">
      <p>“¿Quieres que tus usuarios se enamoren de tus diseños? Enamórate de tus usuarios”.</p>
      <cite>Dana Chisnell</cite>
    </blockquote>
  </section>

  <section class="featured" aria-label="Proyectos destacados">
    <div class="container">
      <ul class="featured__grid">
        {
          projects.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))
        }
      </ul>
      <div class="actions featured__more">
        <a class="btn btn--ghost" href="/proyectos">Ver todos los proyectos <ArrowIcon /></a>
      </div>
    </div>
  </section>

  <ContactBlock />
</Base>

<style>
  /* Sobre mí */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 640px) minmax(0, 1fr);
    align-items: center;
    gap: 48px;
    padding-block: clamp(64px, 8vw, 112px);
  }

  .intro__copy {
    display: grid;
    justify-items: start;
    gap: 20px;
  }

  .intro__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    margin-top: 8px;
    padding: 20px 0;
  }

  /* Number on top of each label, all numbers on the same line */
  .intro__facts div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding-inline: 24px;
  }

  .intro__facts div + div {
    border-left: 1px solid var(--panel-line);
  }

  .intro__facts dt {
    color: var(--muted);
    font-size: 13px;
    font-weight: var(--fw-light);
  }

  .intro__facts dd {
    color: var(--purple);
    font-size: 32px;
    font-weight: var(--fw-bold);
    line-height: 1.2;
  }

  .intro__actions {
    margin-top: 12px;
  }

  .intro__photo {
    justify-self: end;
    width: min(100%, 400px);
    height: auto;
  }

  /* Banner de proyectos */
  /* Outer columns match the container edges, so the label and the quote line up with every other section */
  .projects-banner {
    display: grid;
    grid-template-columns: var(--edge) calc((100% - 2 * var(--edge)) / 3) minmax(0, 1fr) var(--edge);
    min-height: 363px;
  }

  .projects-banner__label {
    grid-area: 1 / 2;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 12px;
    padding-block: 48px;
    padding-right: 32px;
  }

  .projects-banner__media {
    grid-area: 1 / 3 / 2 / 5;
    position: relative;
    overflow: hidden;
    background: var(--purple);
  }

  .projects-banner__image {
    position: absolute;
    top: -25%;
    left: 0;
    width: 97%;
    height: 162%;
    object-fit: cover;
  }

  .projects-banner__tint {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 64.9%;
    right: 0;
    background: var(--fuchsia);
    mix-blend-mode: multiply;
  }

  .projects-banner__quote {
    grid-area: 1 / 3;
    position: relative;
    align-self: center;
    justify-self: end;
    max-width: 400px;
    margin-block: 40px;
    padding: clamp(22px, 2.6vw, 32px);
  }

  /* Rejilla de proyectos */
  .featured {
    padding-block: clamp(56px, 7vw, 96px);
    background: var(--purple-06);
  }

  .featured__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
    padding: 0;
    list-style: none;
  }

  .featured__more {
    justify-content: center;
    margin-top: 48px;
  }

  @media (max-width: 900px) {
    .intro {
      grid-template-columns: 1fr;
    }

    .intro__photo {
      grid-row: 1;
      justify-self: center;
      width: min(70%, 300px);
    }

    .projects-banner {
      grid-template-columns: var(--gutter) minmax(0, 1fr) var(--gutter);
    }

    .projects-banner__label {
      grid-area: 1 / 2;
      padding-block: 56px 32px;
      padding-right: 0;
    }

    .projects-banner__media {
      grid-area: 2 / 1 / 3 / 4;
      min-height: 300px;
    }

    .projects-banner__quote {
      grid-area: 2 / 2;
    }

    .projects-banner__image {
      top: 0;
      width: 100%;
      height: 100%;
    }

    .projects-banner__tint {
      left: 45%;
    }
  }

  @media (max-width: 760px) {
    .featured__grid {
      grid-template-columns: 1fr;
    }

    .intro__facts div {
      padding-inline: 12px;
    }

    .intro__facts dd {
      font-size: 22px;
    }

    .projects-banner__quote {
      justify-self: stretch;
      max-width: none;
      margin-block: 32px;
    }
  }
</style>

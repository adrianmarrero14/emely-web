---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBar from '../components/CtaBar.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import emelyPhoto from '../assets/about/emely.png';
import skillsBg from '../assets/figma/skills-bg.png';
import skillsSketch from '../assets/figma/skills-sketch.png';
import { site } from '../data/site';

const story = [
  {
    title: 'De Caracas a Madrid',
    text: 'Nací en Caracas, Venezuela, donde me gradué como diseñadora gráfica. Hoy vivo y trabajo en Madrid, España.',
  },
  {
    title: 'Diseño con narrativa',
    text: 'Desde pequeña dibujo cómics y escribo historias de fantasía. Esa pasión por la narrativa visual influye en cómo diseño: cada interfaz cuenta una historia.',
  },
  {
    title: 'La ciencia del usuario',
    text: 'Me formé en usabilidad y diseño de interfaces para productos digitales a través de plataformas de aprendizaje en línea. Así llegué a lo que se conoce como “la ciencia del usuario”.',
  },
];

const services = [
  {
    title: 'Investigación UX',
    items: ['Entrevistas y encuestas', 'Benchmarks y análisis competitivo', 'User personas, mapas de empatía y user journeys'],
  },
  {
    title: 'Testing',
    items: ['Pruebas de usabilidad y de deseabilidad', 'Testeo de prototipos y MVP'],
  },
  {
    title: 'Diseño de interfaces',
    items: ['Wireframes', 'Prototipos de media y alta fidelidad'],
  },
  {
    title: 'Sistemas de diseño',
    items: ['Guías de estilo y librerías de componentes', 'Especificaciones y entrega a desarrollo'],
  },
  {
    title: 'Metodologías ágiles',
    items: ['Design Thinking', 'Scrum', 'Kanban'],
  },
];

const stack = [
  {
    title: 'Product Strategy & Research',
    items: ['User journeys', 'Benchmarking', 'Tests de usabilidad', 'Arquitectura de información', 'Mapas de empatía'],
  },
  {
    title: 'UI, Visual & Design Systems',
    items: ['Figma: variables avanzadas, auto-layout, componentes y tokens', 'Framer', 'Accesibilidad (WCAG)', 'Visualización de datos'],
  },
  {
    title: 'Herramientas y gestión',
    items: ['Jira', 'Notion', 'Maze', 'Metodologías ágiles'],
  },
  {
    title: 'AI Tools & Automatización',
    items: [
      'Flujos de research optimizados con IA',
      'Ideación asistida',
      'Generación de contenido y copys',
      'Automatización de flujos operativos',
    ],
  },
];

const experience = [
  {
    period: 'may. 2026 – actualidad',
    current: true,
    company: 'Darien Technology',
    role: 'Diseñadora de Producto',
    description:
      'Conceptualización, arquitectura y escalado del sistema de diseño de PinsXP, con flujos asistidos por IA para la tokenización y una entrega más rápida.',
  },
  {
    period: 'nov. 2024 – mar. 2026',
    company: 'Finaer',
    role: 'Diseñadora de Producto',
    description: 'Liderazgo end-to-end en el diseño de productos inmobiliarios.',
  },
  {
    period: 'ene. 2024 – nov. 2024',
    company: 'Amaris Consulting',
    role: 'Diseñadora UX/UI',
    description: 'Optimización de los flujos críticos de onboarding bancario de OpenBank USA.',
  },
  {
    period: 'sept. 2022 – nov. 2023',
    company: 'ingg',
    role: 'Diseñadora de Producto',
    description: 'Herramientas de visualización de datos y calculadoras financieras.',
  },
  {
    period: 'ene. 2021 – dic. 2022',
    company: 'Darien Technology',
    role: 'Diseñadora UX/UI',
    description: 'Banca online y móvil para Banco Mercantil Panamá.',
  },
];
---

<Base title="Sobre mí" description="Conoce a Emely Aponte: su historia, lo que hace como diseñadora UX/UI, sus herramientas y su trayectoria profesional.">
  <section class="story container">
    <div class="story__copy">
      <p class="eyebrow">Sobre mí</p>
      <h1 class="title-xl">Hola, soy Emely. <span class="text-purple">Diseño productos digitales escalables con foco en usabilidad, estrategia y sistemas de diseño.</span></h1>
      <p class="lead">
        Llevo <strong>10 años en el diseño gráfico y 8 como diseñadora UX/UI</strong>. Esa combinación me permite crear
        interfaces visualmente atractivas y, sobre todo, funcionales.
      </p>

      <ul class="story__chapters">
        {
          story.map((chapter) => (
            <li>
              <h2>{chapter.title}</h2>
              <p>{chapter.text}</p>
            </li>
          ))
        }
      </ul>

      <div class="story__actions">
        <a class="btn" href={site.cvAbout} target="_blank" rel="noopener noreferrer">
          Ver mi currículum <ArrowIcon />
          <span class="visually-hidden">(se abre en una pestaña nueva)</span>
        </a>
        <a class="btn btn--ghost" href="/proyectos">Ver proyectos</a>
      </div>
    </div>

    <Image
      class="story__photo"
      src={emelyPhoto}
      alt="Emely Aponte sonriendo, en blanco y negro"
      widths={[400, 800]}
      sizes="(max-width: 900px) 90vw, 40vw"
      loading="eager"
    />
  </section>

  <section class="services" aria-labelledby="services-title">
    <div class="container">
      <p class="eyebrow">Qué hago</p>
      <h2 id="services-title" class="title-lg">Del descubrimiento a la entrega</h2>
      <p class="lead services__lead">Acompaño todo el ciclo de diseño de un producto digital.</p>
      <ol class="services__grid">
        {
          services.map((service, index) => (
            <li class="service">
              <span class="service__number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{service.title}</h3>
              <ul>
                {service.items.map((item) => <li>{item}</li>)}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="skills" aria-labelledby="skills-title">
    <Image class="skills__bg" src={skillsBg} alt="" widths={[800, 1440, skillsBg.width]} sizes="100vw" />
    <div class="skills__tint" aria-hidden="true"></div>
    <div class="container skills__inner">
      <div class="skills__intro">
        <div>
          <p class="eyebrow skills__eyebrow">Stack y habilidades</p>
          <h2 id="skills-title" class="title-lg skills__title">Con qué trabajo</h2>
        </div>
        <p class="skills__note">
          Creo que el aprendizaje <strong>nunca se detiene</strong>: cada día amplío y perfecciono mis habilidades, hoy
          también con herramientas de IA.
        </p>
      </div>

      <ul class="skills__grid">
        {
          stack.map((group, index) => (
            <li class="skills__group">
              <span class="skills__number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{group.title}</h3>
              <ul class="skills__chips">
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="experience" aria-labelledby="experience-title">
    <Image class="experience__sketch" src={skillsSketch} alt="" widths={[651, 1302]} sizes="45vw" />
    <div class="container experience__inner">
      <p class="eyebrow">Experiencia</p>
      <h2 id="experience-title" class="title-lg">Trayectoria profesional</h2>
      <ol class="timeline">
        {
          experience.map((job) => (
            <li class="timeline__item">
              <p class="timeline__period">
                {job.period}
                {job.current && <span class="timeline__badge">Actual</span>}
              </p>
              <h3 class="timeline__role">{job.role}</h3>
              <p class="timeline__company">{job.company}</p>
              <p>{job.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBar />
</Base>

<style>
  /* Historia */
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: start;
    padding-block: clamp(56px, 7vw, 96px);
  }

  .story__copy {
    display: grid;
    justify-items: start;
    gap: 22px;
  }

  .story__copy h1 {
    font-size: clamp(32px, 4vw, 52px);
  }

  .story__chapters {
    display: grid;
    gap: 22px;
    margin-top: 12px;
    padding: 0;
    list-style: none;
  }

  .story__chapters li {
    padding-left: 20px;
    border-left: 3px solid var(--fuchsia);
  }

  .story__chapters h2 {
    margin-bottom: 4px;
    font-size: 17px;
    font-weight: var(--fw-semibold);
  }

  .story__chapters p {
    font-size: 15px;
  }

  .story__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .story__photo {
    position: sticky;
    top: 32px;
    justify-self: end;
    width: min(calc(100% - 24px), 480px);
    height: auto;
    border-radius: var(--radius);
    box-shadow: 24px 24px 0 var(--purple);
  }

  /* Qué hago */
  .services {
    padding-block: clamp(64px, 8vw, 112px);
    background: var(--purple-06);
  }

  .services__lead {
    margin-top: 12px;
  }

  .services .title-lg {
    margin-top: 12px;
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 20px;
    margin-top: 40px;
    padding: 0;
    list-style: none;
  }

  .service {
    padding: 28px 24px;
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
  }

  .service__number {
    color: var(--fuchsia);
    font-size: 14px;
    font-weight: var(--fw-semibold);
  }

  .service h3 {
    margin-block: 6px 12px;
    color: var(--purple);
    font-size: 18px;
    font-weight: var(--fw-semibold);
  }

  .service ul {
    display: grid;
    gap: 6px;
    padding-left: 18px;
    font-size: 14px;
    line-height: 1.5;
  }

  .service li::marker {
    color: var(--fuchsia);
  }

  /* Herramientas */
  .skills {
    position: relative;
    overflow: hidden;
    color: var(--white);
  }

  .skills__bg,
  .skills__tint {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .skills__bg {
    object-fit: cover;
    filter: grayscale(1);
  }

  /* Even brand tint so the glass cards read the same over light and dark parts of the photo */
  .skills__tint {
    background: linear-gradient(120deg, rgb(102 0 191 / 0.94) 0%, rgb(102 0 191 / 0.86) 55%, rgb(201 0 157 / 0.82) 100%);
  }

  .skills__inner {
    position: relative;
    display: grid;
    gap: clamp(32px, 4vw, 48px);
    padding-block: clamp(64px, 8vw, 112px);
  }

  .skills__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
    align-items: end;
    gap: 24px 48px;
  }

  .skills__eyebrow {
    color: var(--white);
  }

  .skills__title {
    margin-top: 12px;
    color: var(--white);
  }

  .skills__note {
    padding: 16px 20px;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.95);
    color: var(--text);
  }

  .skills__note strong {
    color: var(--purple);
  }

  .skills__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    padding: 0;
    list-style: none;
  }

  /* Glass cards over the purple duotone photo */
  .skills__group {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px 24px;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 16px;
    background: rgb(255 255 255 / 0.1);
    backdrop-filter: blur(14px);
  }

  .skills__number {
    font-size: 14px;
    font-weight: var(--fw-semibold);
    opacity: 0.75;
  }

  .skills__group h3 {
    color: var(--white);
    font-size: 18px;
    font-weight: var(--fw-semibold);
    line-height: 1.3;
  }

  .skills__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    list-style: none;
  }

  .skills__chips li {
    padding: 6px 12px;
    border-radius: 8px;
    background: rgb(255 255 255 / 0.14);
    font-size: 13px;
    font-weight: var(--fw-medium);
    line-height: 1.4;
  }

  /* Trayectoria */
  .experience {
    position: relative;
    overflow: hidden;
    background: var(--surface);
  }

  .experience__sketch {
    position: absolute;
    top: 0;
    right: 0;
    width: 45%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
    transform: scaleY(-1);
  }

  .experience__inner {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 12px;
    padding-block: clamp(64px, 8vw, 112px);
  }

  .timeline {
    display: grid;
    max-width: 720px;
    margin-top: 28px;
    padding: 0;
    list-style: none;
  }

  /* Vertical line with a fuchsia dot per role */
  .timeline__item {
    position: relative;
    padding: 0 0 36px 36px;
    font-size: 15px;
  }

  .timeline__item::before {
    content: '';
    position: absolute;
    top: 10px;
    bottom: 0;
    left: 5px;
    width: 2px;
    background: var(--purple-24);
  }

  .timeline__item:last-child {
    padding-bottom: 0;
  }

  .timeline__item:last-child::before {
    display: none;
  }

  .timeline__item::after {
    content: '';
    position: absolute;
    top: 6px;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--fuchsia);
    box-shadow: 0 0 0 4px var(--surface);
  }

  .timeline__period {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 4px;
    color: var(--purple);
    font-size: 14px;
    font-weight: var(--fw-semibold);
  }

  .timeline__badge {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--fuchsia);
    color: var(--white);
    font-size: 12px;
    font-weight: var(--fw-medium);
  }

  .timeline__role {
    font-size: 18px;
    font-weight: var(--fw-semibold);
  }

  .timeline__company {
    margin-bottom: 6px;
    color: var(--muted);
    font-size: 14px;
    font-weight: var(--fw-medium);
  }

  @media (max-width: 1100px) {
    .skills__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 1024px) {
    .story {
      grid-template-columns: 1fr;
    }

    .story__photo {
      position: static;
      grid-row: 1;
      justify-self: start;
      width: min(calc(100% - 24px), 420px);
    }

    .skills__intro {
      grid-template-columns: 1fr;
    }

    .experience__sketch {
      width: 100%;
      opacity: 0.12;
    }
  }

  @media (max-width: 640px) {
    .skills__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

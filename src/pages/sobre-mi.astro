---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBar from '../components/CtaBar.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import emelyPhoto from '../assets/about/emely.png';
import skillsBg from '../assets/figma/skills-bg.png';
import skillsSketch from '../assets/figma/skills-sketch.png';
import { site } from '../data/site';

const story = [
  {
    title: 'De Caracas a Madrid',
    text: 'Nací en Caracas, Venezuela, donde me gradué como diseñadora gráfica. Hoy vivo y trabajo en Madrid, España.',
  },
  {
    title: 'Diseño con narrativa',
    text: 'Desde pequeña dibujo cómics y escribo historias de fantasía. Esa pasión por la narrativa visual influye en cómo diseño: cada interfaz cuenta una historia.',
  },
  {
    title: 'La ciencia del usuario',
    text: 'Me formé en usabilidad y diseño de interfaces para productos digitales a través de plataformas de aprendizaje en línea. Así llegué a lo que se conoce como “la ciencia del usuario”.',
  },
];

const services = [
  {
    title: 'Investigación UX',
    items: ['Entrevistas y encuestas', 'Benchmarks y análisis competitivo', 'User personas, mapas de empatía y user journeys'],
  },
  {
    title: 'Testing',
    items: ['Pruebas de usabilidad y de deseabilidad', 'Testeo de prototipos y MVP'],
  },
  {
    title: 'Diseño de interfaces',
    items: ['Wireframes', 'Prototipos de media y alta fidelidad'],
  },
  {
    title: 'Sistemas de diseño',
    items: ['Guías de estilo y librerías de componentes', 'Especificaciones y entrega a desarrollo'],
  },
  {
    title: 'Metodologías ágiles',
    items: ['Design Thinking', 'Scrum', 'Kanban'],
  },
];

// Bar lengths taken from the Figma file (filled width / 481px track).
const skills = [
  { name: 'Figma', level: 85 },
  { name: 'Photoshop', level: 85 },
  { name: 'Illustrator', level: 85 },
  { name: 'Maze', level: 85 },
  { name: 'InVision', level: 68 },
  { name: 'InDesign', level: 63 },
  { name: 'After Effects', level: 49 },
  { name: 'WordPress', level: 36 },
  { name: 'HTML', level: 36 },
  { name: 'CSS', level: 36 },
];

const experience = [
  {
    period: '2021',
    company: 'Darien Technology',
    role: 'Diseñadora UX/UI',
    description:
      'Investigación, ideación, prototipado y diseño de los productos digitales de Mercantil Banco Panamá.',
  },
  {
    period: '2019 – 2020',
    company: 'Lookers Inbound',
    role: 'Diseñadora gráfica y web',
    description:
      'Dirección, diseño y desarrollo de piezas para redes sociales, flyers digitales e impresos, branding e interfaces para la agencia de inbound marketing Lookers.',
  },
  {
    period: '2017 – 2019',
    company: 'Wikot Technologies',
    role: 'Diseñadora UX/UI',
    description:
      'Investigación, ideación, prototipado y diseño de productos digitales para esta agencia de tecnología y marketing digital.',
  },
  {
    period: '2016 – 2017',
    company: 'Seis Grados Media',
    role: 'Diseñadora gráfica digital',
    description:
      'Conceptos visuales y piezas para redes sociales (banners, animaciones, 360 y vídeos) para esta agencia de marketing digital.',
  },
  {
    period: '2016',
    company: 'La Web Mercadeo Interactivo',
    role: 'Diseñadora gráfica digital junior',
    description:
      'Conceptos visuales y piezas para redes sociales (banners, animaciones, 360 y vídeos) para esta agencia de marketing digital.',
  },
];
---

<Base title="Sobre mí" description="Conoce a Emely Aponte: su historia, lo que hace como diseñadora UX/UI, sus herramientas y su trayectoria profesional.">
  <section class="story container">
    <div class="story__copy">
      <p class="eyebrow">Sobre mí</p>
      <h1 class="title-xl">Hola, soy Emely. <span class="text-purple">Diseño experiencias digitales con mirada de ilustradora.</span></h1>
      <p class="lead">
        Llevo <strong>10 años en el diseño gráfico y 8 como diseñadora UX/UI</strong>. Esa combinación me permite crear
        interfaces visualmente atractivas y, sobre todo, funcionales.
      </p>

      <ul class="story__chapters">
        {
          story.map((chapter) => (
            <li>
              <h2>{chapter.title}</h2>
              <p>{chapter.text}</p>
            </li>
          ))
        }
      </ul>

      <div class="story__actions">
        <a class="btn" href={site.cvAbout} target="_blank" rel="noopener noreferrer">
          Ver mi currículum <ArrowIcon />
          <span class="visually-hidden">(se abre en una pestaña nueva)</span>
        </a>
        <a class="btn btn--ghost" href="/proyectos">Ver proyectos</a>
      </div>
    </div>

    <Image
      class="story__photo"
      src={emelyPhoto}
      alt="Emely Aponte sonriendo, en blanco y negro"
      widths={[400, 800]}
      sizes="(max-width: 900px) 90vw, 40vw"
      loading="eager"
    />
  </section>

  <section class="services" aria-labelledby="services-title">
    <div class="container">
      <p class="eyebrow">Qué hago</p>
      <h2 id="services-title" class="title-lg">Del descubrimiento a la entrega</h2>
      <p class="lead services__lead">Acompaño todo el ciclo de diseño de un producto digital.</p>
      <ol class="services__grid">
        {
          services.map((service, index) => (
            <li class="service">
              <span class="service__number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{service.title}</h3>
              <ul>
                {service.items.map((item) => <li>{item}</li>)}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="skills" aria-labelledby="skills-title">
    <Image class="skills__bg" src={skillsBg} alt="" widths={[800, 1440, skillsBg.width]} sizes="100vw" />
    <div class="skills__tint" aria-hidden="true"></div>
    <div class="container skills__inner">
      <div class="skills__intro">
        <p class="eyebrow skills__eyebrow">Herramientas</p>
        <h2 id="skills-title" class="title-lg skills__title">Con qué trabajo</h2>
        <p class="skills__note">
          Creo que el aprendizaje <strong>nunca se detiene</strong>: cada día amplío y perfecciono mis habilidades.
        </p>
      </div>

      <ul class="skills__panel">
        {
          skills.map((skill) => (
            <li>
              <span class="skills__name">{skill.name}</span>
              <span
                class="skills__bar"
                role="meter"
                aria-label={`Nivel de ${skill.name}`}
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow={skill.level}
                style={`--level: ${skill.level}%`}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="experience" aria-labelledby="experience-title">
    <Image class="experience__sketch" src={skillsSketch} alt="" widths={[651, 1302]} sizes="45vw" />
    <div class="container experience__inner">
      <p class="eyebrow">Experiencia</p>
      <h2 id="experience-title" class="title-lg">Trayectoria profesional</h2>
      <ol class="timeline">
        {
          experience.map((job) => (
            <li class="timeline__item">
              <p class="timeline__period">{job.period}</p>
              <div class="timeline__body">
                <h3 class="timeline__role">{job.role}</h3>
                <p class="timeline__company">{job.company}</p>
                <p>{job.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBar />
</Base>

<style>
  /* Historia */
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: start;
    padding-block: clamp(56px, 7vw, 96px);
  }

  .story__copy {
    display: grid;
    justify-items: start;
    gap: 22px;
  }

  .story__copy h1 {
    font-size: clamp(32px, 4vw, 52px);
  }

  .story__chapters {
    display: grid;
    gap: 22px;
    margin-top: 12px;
    padding: 0;
    list-style: none;
  }

  .story__chapters li {
    padding-left: 20px;
    border-left: 3px solid var(--fuchsia);
  }

  .story__chapters h2 {
    margin-bottom: 4px;
    font-size: 17px;
    font-weight: var(--fw-semibold);
  }

  .story__chapters p {
    font-size: 15px;
  }

  .story__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .story__photo {
    position: sticky;
    top: 32px;
    justify-self: end;
    width: min(calc(100% - 24px), 480px);
    height: auto;
    border-radius: var(--radius);
    box-shadow: 24px 24px 0 var(--purple);
  }

  /* Qué hago */
  .services {
    padding-block: clamp(64px, 8vw, 112px);
    background: var(--purple-06);
  }

  .services__lead {
    margin-top: 12px;
  }

  .services .title-lg {
    margin-top: 12px;
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 20px;
    margin-top: 40px;
    padding: 0;
    list-style: none;
  }

  .service {
    padding: 28px 24px;
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
  }

  .service__number {
    color: var(--fuchsia);
    font-size: 14px;
    font-weight: var(--fw-semibold);
  }

  .service h3 {
    margin-block: 6px 12px;
    color: var(--purple);
    font-size: 18px;
    font-weight: var(--fw-semibold);
  }

  .service ul {
    display: grid;
    gap: 6px;
    padding-left: 18px;
    font-size: 14px;
    line-height: 1.5;
  }

  .service li::marker {
    color: var(--fuchsia);
  }

  /* Herramientas */
  .skills {
    position: relative;
    overflow: hidden;
    color: var(--white);
  }

  .skills__bg,
  .skills__tint {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .skills__bg {
    object-fit: cover;
  }

  .skills__tint {
    background: var(--purple);
    mix-blend-mode: multiply;
  }

  .skills__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 480px) minmax(0, 600px);
    justify-content: space-between;
    align-items: center;
    gap: 48px;
    padding-block: clamp(64px, 8vw, 112px);
  }

  .skills__intro {
    display: grid;
    justify-items: start;
    gap: 16px;
  }

  .skills__eyebrow {
    color: var(--white);
  }

  .skills__title {
    color: var(--white);
  }

  .skills__note {
    padding: 16px 20px;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.95);
    color: var(--text);
  }

  .skills__note strong {
    color: var(--purple);
  }

  .skills__panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px 40px;
    padding: clamp(28px, 4vw, 48px);
    border-radius: var(--radius);
    background: var(--purple);
    list-style: none;
  }

  .skills__name {
    display: block;
    margin-bottom: 8px;
    font-size: 15px;
    font-weight: var(--fw-medium);
  }

  .skills__bar {
    display: block;
    height: 8px;
    border-radius: 60px;
    background:
      linear-gradient(var(--fuchsia), var(--fuchsia)) left / var(--level) 100% no-repeat,
      rgb(255 255 255 / 0.3);
  }

  /* Trayectoria */
  .experience {
    position: relative;
    overflow: hidden;
    background: var(--surface);
  }

  .experience__sketch {
    position: absolute;
    top: 0;
    right: 0;
    width: 45%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
    transform: scaleY(-1);
  }

  .experience__inner {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 12px;
    padding-block: clamp(64px, 8vw, 112px);
  }

  .timeline {
    display: grid;
    max-width: 680px;
    margin-top: 28px;
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 24px;
    padding-bottom: 32px;
  }

  /* Vertical line and dot */
  .timeline__item::before {
    content: '';
    position: absolute;
    top: 8px;
    bottom: 0;
    left: 131px;
    width: 2px;
    background: var(--purple-24);
  }

  .timeline__item:last-child::before {
    display: none;
  }

  .timeline__item::after {
    content: '';
    position: absolute;
    top: 6px;
    left: 126px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--fuchsia);
    box-shadow: 0 0 0 4px var(--surface);
  }

  .timeline__period {
    color: var(--purple);
    font-size: 15px;
    font-weight: var(--fw-semibold);
  }

  .timeline__body {
    padding-left: 24px;
    font-size: 15px;
  }

  .timeline__role {
    font-size: 18px;
    font-weight: var(--fw-semibold);
  }

  .timeline__company {
    margin-bottom: 6px;
    color: var(--muted);
    font-size: 14px;
    font-weight: var(--fw-medium);
  }

  @media (max-width: 1024px) {
    .story {
      grid-template-columns: 1fr;
    }

    .story__photo {
      position: static;
      grid-row: 1;
      justify-self: start;
      width: min(calc(100% - 24px), 420px);
    }

    .skills__inner {
      grid-template-columns: 1fr;
    }

    .experience__sketch {
      width: 100%;
      opacity: 0.12;
    }
  }

  @media (max-width: 560px) {
    .skills__panel {
      grid-template-columns: 1fr;
    }

    .timeline__item {
      grid-template-columns: 1fr;
      gap: 4px;
      padding-left: 28px;
    }

    .timeline__item::before {
      left: 5px;
    }

    .timeline__item::after {
      left: 0;
    }

    .timeline__body {
      padding-left: 0;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import portfolioHero from '../assets/figma/portfolio-hero.png';
import portfolioDesk from '../assets/figma/portfolio-desk.png';
import { projects, upcomingProjects } from '../data/site';

const tiles = [
  ...projects.map((project) => ({
    name: project.name,
    category: project.category,
    portrait: project.portrait,
    href: project.href,
    status: project.href ? undefined : 'Caso de estudio próximamente',
  })),
  ...upcomingProjects.map((project) => ({
    name: project.name,
    category: 'En construcción',
    portrait: project.portrait,
    href: undefined,
    status: undefined,
  })),
];
const featured = projects[0];
---

<Base title="¿Qué hago?" description="Una muestra del trabajo de Emely Aponte: sistemas de diseño, aplicaciones móviles, banca y web.">
  <section class="intro">
    <Image class="intro__image" src={portfolioHero} alt="" widths={[640, portfolioHero.width]} sizes="100vw" loading="eager" />
    <div class="intro__block intro__block--purple" aria-hidden="true"></div>
    <div class="intro__block intro__block--magenta" aria-hidden="true"></div>
    <div class="container intro__copy">
      <a href="/" class="intro__logo">
        <img src="/icons/logo-stacked-141.svg" width="141" height="72.0557" alt="Emely Aponte, ir al inicio" />
      </a>
      <p class="intro__eyebrow">Portafolio</p>
      <h1 class="heading intro__title">¡Esta es una muestra de mi trabajo!</h1>
    </div>
  </section>

  <section class="featured" aria-label="Destacado">
    <div class="featured__aside">
      <PhoneMockup screen={featured.portrait} alt={`Proyecto ${featured.name}`} />
      <a class="arrow-link featured__link" href="#proyectos">
        ¡Ir al portafolio ya!
        <img src="/icons/arrow-white-20.svg" width="20" height="15.0007" alt="" />
      </a>
    </div>
    <div class="featured__photo">
      <Image class="featured__image" src={portfolioDesk} alt="" widths={[700, 1000, 1400]} sizes="(max-width: 760px) 100vw, 69vw" />
      <div class="featured__tint" aria-hidden="true"></div>
      <blockquote class="quote featured__quote">
        <p>“El diseño digital es como una pintura en óleo, excepto que la pintura nunca se seca”.</p>
        <cite>Neville Brody</cite>
      </blockquote>
    </div>
  </section>

  <section id="proyectos" class="grid" aria-labelledby="grid-title">
    <h2 id="grid-title" class="visually-hidden">Proyectos</h2>
    <ul>
      {
        tiles.map((tile) => (
          <li class="tile">
            <PhoneMockup screen={tile.portrait} alt="" class="tile__phone" />
            <h3 class="tile__name">
              {tile.href ? <a href={tile.href}>{tile.name}</a> : tile.name}
            </h3>
            <p class="tile__category">{tile.category}</p>
            {tile.href ? (
              <span class="arrow-link tile__cta" aria-hidden="true">
                Ver caso de estudio
                <img src="/icons/arrow-white-20.svg" width="20" height="15.0007" alt="" />
              </span>
            ) : (
              tile.status && <p class="tile__status">{tile.status}</p>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  /* Cabecera con portátil */
  .intro {
    position: relative;
    min-height: clamp(560px, 52.9vw, 762px);
    overflow: hidden;
    background: #eceae7;
  }

  .intro__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% center;
  }

  .intro__block {
    position: absolute;
    mix-blend-mode: multiply;
  }

  .intro__block--purple {
    top: 0;
    left: 36.25%;
    width: 18.7%;
    height: 49%;
    background: var(--purple);
  }

  .intro__block--magenta {
    top: 28.3%;
    right: -0.6%;
    width: 19.3%;
    height: 52.2%;
    background: var(--magenta);
  }

  .intro__copy {
    position: relative;
    padding-top: 31px;
    padding-left: clamp(16px, 4.9vw, 70px);
  }

  .intro__logo img {
    width: 141px;
    height: auto;
  }

  .intro__eyebrow {
    width: fit-content;
    margin-top: clamp(48px, 7.4vw, 110px);
    margin-left: clamp(0px, 1.95vw, 28px);
    padding-bottom: 14px;
    border-bottom: 8px solid var(--magenta);
    font-size: 18px;
    min-width: 117px;
  }

  .intro__title {
    max-width: 407px;
    margin-top: 38px;
    margin-left: clamp(0px, 1.95vw, 28px);
    font-size: clamp(36px, 3.33vw, 48px);
    line-height: 1.25;
  }

  /* Bloque destacado */
  .featured {
    display: grid;
    grid-template-columns: 31.3% 1fr;
    min-height: clamp(520px, 51.3vw, 739px);
    color: var(--white);
  }

  .featured__aside {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 40px;
    padding: 64px 16px;
    background: var(--purple);
  }

  .featured__link {
    align-self: flex-start;
    margin-left: clamp(16px, 8.5vw, 123px);
    color: var(--white);
  }

  .featured__photo {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    overflow: hidden;
    padding: 64px clamp(24px, 5.3vw, 76px) clamp(64px, 9.2vw, 133px) 24px;
  }

  .featured__image,
  .featured__tint {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .featured__image {
    object-fit: cover;
    transform: scaleY(-1);
  }

  .featured__tint {
    background: var(--purple);
    mix-blend-mode: multiply;
  }

  .featured__quote {
    position: relative;
    max-width: 375px;
  }

  /* Rejilla de proyectos */
  .grid ul {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: clamp(480px, 39.6vw, 571px);
    padding: 40px 24px 56px;
    color: var(--white);
    text-align: center;
    background: var(--magenta);
  }

  .tile:nth-child(even) {
    background: var(--purple);
  }

  .tile__phone {
    width: min(100%, 396px);
    transition: transform 0.3s ease;
  }

  .tile:has(a):hover .tile__phone {
    transform: translateY(-6px);
  }

  .tile__name {
    margin-top: 8px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 34px;
    line-height: 1.1;
  }

  .tile__name a {
    text-decoration: none;
  }

  /* Whole tile is clickable when there is a case study */
  .tile__name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .tile__name a:focus-visible {
    outline: none;
  }

  .tile:has(a:focus-visible) {
    outline: 3px solid var(--white);
    outline-offset: -8px;
  }

  .tile__category {
    margin-top: 4px;
    font-size: 16px;
  }

  .tile__cta,
  .tile__status {
    margin-top: 14px;
    font-size: 16px;
  }

  .tile__status {
    opacity: 0.75;
    font-style: italic;
  }

  @media (max-width: 1024px) {
    .grid ul {
      grid-template-columns: repeat(2, 1fr);
    }

    .tile:nth-child(4n + 1),
    .tile:nth-child(4n) {
      background: var(--magenta);
    }

    .tile:nth-child(4n + 2),
    .tile:nth-child(4n + 3) {
      background: var(--purple);
    }
  }

  @media (max-width: 760px) {
    .intro__block--purple {
      left: 55%;
      width: 30%;
      height: 30%;
    }

    .intro__block--magenta {
      top: 60%;
      width: 30%;
      height: 35%;
    }

    .featured {
      grid-template-columns: 1fr;
    }

    .featured__aside {
      padding-block: 48px;
    }

    .featured__aside :global(.phone) {
      max-width: 300px;
    }

    .featured__link {
      align-self: center;
      margin-left: 0;
    }

    .featured__photo {
      min-height: 420px;
    }

    .grid ul {
      grid-template-columns: 1fr;
    }

    .tile,
    .tile:nth-child(n) {
      min-height: 0;
      background: var(--magenta);
    }

    .tile:nth-child(even) {
      background: var(--purple);
    }

    .tile__phone {
      width: min(100%, 320px);
    }
  }
</style>
